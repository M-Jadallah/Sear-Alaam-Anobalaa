    },
    {
      "segment_id": 8274,
      "assessment": "no_clear_topic",
      "note": "زواج النبي بأم سلمة بعد انقضاء عدتها من زوجها.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8275,
      "assessment": "no_clear_topic",
      "note": "رواية أم سلمة القول عند المصيبة واستعظامها الخلف، ثم فرحها بزواج النبي.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8276,
      "assessment": "no_clear_topic",
      "note": "يذكر موت أبي سلمة كهلا في سنة ثلاث، ويأتي في آخر الترجمة قول آخر بسنة أربع.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8277,
      "assessment": "supported",
      "note": "نقل ابن إسحاق أولية هجرته إلى الحبشة وعودته مع عثمان وإجارة أبي طالب له.",
      "topics": [
        {
          "topic": "الهجرة",
          "category": "التاريخ والمجتمع",
          "aliases": [],
          "rationale": "ينقل أولية هجرته وعودته وإجارة أبي طالب له.",
          "relation_type": "event",
          "subject_scope": "biography_subject",
          "stance": "reported",
          "evidence_start": 1609305,
          "evidence_end": 1609330,
          "context_start": 1609288,
          "context_end": 1609463
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8278,
      "assessment": "no_clear_topic",
      "note": "تعليق على عودتهم عند سماع إسلام أهل مكة ونزول سورة والنجم.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8279,
      "assessment": "no_clear_topic",
      "note": "نقل مصعب بن عبد الله أسماء أولاد أم سلمة الذين ولدتهم له بالحبشة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8280,
      "assessment": "no_clear_topic",
      "note": "تعليق المؤلف على زمن ولادة هؤلاء بالحبشة قبل عام الهجرة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8281,
      "assessment": "no_clear_topic",
      "note": "إسناد خبر أم سلمة عن حضور الميت وما قالته بعد وفاة أبي سلمة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8282,
      "assessment": "supported",
      "note": "تعليم قول الخير عند الميت وتأمين الملائكة عليه في رواية أم سلمة.",
      "topics": [
        {
          "topic": "الدعاء",
          "category": "القلب والسلوك",
          "aliases": [],
          "rationale": "تنقل أم سلمة وصية قول الخير عند الميت وتتبعها بدعاء النبي لها.",
          "relation_type": "saying",
