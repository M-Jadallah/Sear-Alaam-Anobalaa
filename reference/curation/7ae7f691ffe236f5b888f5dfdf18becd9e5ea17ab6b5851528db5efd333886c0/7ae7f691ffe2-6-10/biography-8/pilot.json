    },
    {
      "segment_id": 8286,
      "assessment": "no_clear_topic",
      "note": "تقول أم سلمة إن الله أعقبها رسول الله خيرا منه؛ نسبة القول إليها محفوظة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8287,
      "assessment": "no_clear_topic",
      "note": "إسناد رواية أخرى عن أم سلمة في الدعاء عند المصيبة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8288,
      "assessment": "no_clear_topic",
      "note": "بداية الدعاء عند المصيبة وتتصل العبارة عبر علامة الصفحة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8289,
      "assessment": "no_clear_topic",
      "note": "تكملة الدعاء بعد علامة الصفحة؛ لا تفصل عن صدره.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8290,
      "assessment": "no_clear_topic",
      "note": "تروي أم سلمة ترددها في الدعاء بالخلف لما احتضر أبو سلمة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8291,
      "assessment": "no_clear_topic",
      "note": "تتم أم سلمة خبر قول الدعاء وذكر خطبة أبي بكر وعمر ثم إرسال النبي.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8292,
      "assessment": "no_clear_topic",
      "note": "جواب أم سلمة وترحيبها برسول النبي مع إشارة إلى بقية الحديث.",
      "topics": [],
