    },
    {
      "segment_id": 8283,
      "assessment": "no_clear_topic",
      "note": "انتقال أم سلمة إلى سؤالها بعد وفاة أبي سلمة في الرواية نفسها.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8284,
      "assessment": "no_clear_topic",
      "note": "سؤال أم سلمة عن صيغة ما تقوله، ويتبعه الجواب.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8285,
      "assessment": "supported",
      "note": "جواب النبي بالدعاء بالمغفرة والخلف الصالح، تابع لسؤال أم سلمة.",
      "topics": [
        {
          "topic": "الدعاء",
          "category": "القلب والسلوك",
          "aliases": [],
          "rationale": "جواب النبي عن سؤال أم سلمة بعد موت أبي سلمة.",
          "relation_type": "saying",
          "subject_scope": "general_context",
          "stance": "reported",
          "evidence_start": 1609803,
