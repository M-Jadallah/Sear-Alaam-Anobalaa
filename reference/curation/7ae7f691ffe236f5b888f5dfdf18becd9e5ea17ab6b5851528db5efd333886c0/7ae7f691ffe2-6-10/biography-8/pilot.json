    },
    {
      "segment_id": 8272,
      "assessment": "no_clear_topic",
      "note": "تذكر قرابته للرسول من الرضاعة وكونه ابن عمته برة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8273,
      "assessment": "supported",
      "note": "يسرد السبق والهجرة إلى الحبشة والمدينة وشهود بدر وذكر أولاده.",
      "topics": [
        {
          "topic": "الهجرة",
