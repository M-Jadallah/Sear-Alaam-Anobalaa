      "context_start": 1634907,
      "context_end": 1634985,
      "reason": "عنوان المصدر مستقل عن بيان الاحتمال الآخر لنسبه."
    },
    {
      "start": 1634964,
      "end": 1634985,
      "context_start": 1634907,
      "context_end": 1635147,
      "reason": "قوله أو ابن أبي البكير تعقيب على اسم العنوان قبل افتتاح نقل ابن سعد."
    },
    {
      "start": 1634985,
      "end": 1635147,
      "context_start": 1634964,
      "context_end": 1635157,
      "reason": "قول ابن سعد في المؤاخاة، ثم شهود خالد ومقتله وسنه؛ يجمع عائد الضمير والاسم ضمن خبر الترجمة."
    },
    {
      "start": 1635147,
      "end": 1635157,
      "context_start": 1634985,
      "context_end": 1635157,
      "reason": "عبارة أخوهما تمهيد للعنوان التالي وتبقى جزءًا من النطاق المصدري الحالي."
    }
  ],
