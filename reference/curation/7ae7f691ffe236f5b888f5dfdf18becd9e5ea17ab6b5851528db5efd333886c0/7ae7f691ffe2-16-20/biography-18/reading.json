      "context_start": 1635157,
      "context_end": 1635372,
      "reason": "عنوان المصدر مستقل عن كلام ابن سعد الذي يليه."
    },
    {
      "start": 1635211,
      "end": 1635372,
      "context_start": 1635157,
      "context_end": 1635388,
      "reason": "نقل المؤاخاة والمشاهد ثم فتح مصر والوفاة يتصل في ترجمة إياس، قبل انتقال المصدر إلى أخيه الرابع."
    },
    {
      "start": 1635372,
      "end": 1635388,
      "context_start": 1635211,
      "context_end": 1635388,
      "reason": "عبارة المصدر تمهد للعنوان التالي وهي مستقلة عن وفاة إياس، وتبقى داخل النطاق المستخرج دون تغيير حدوده."
    }
  ],
