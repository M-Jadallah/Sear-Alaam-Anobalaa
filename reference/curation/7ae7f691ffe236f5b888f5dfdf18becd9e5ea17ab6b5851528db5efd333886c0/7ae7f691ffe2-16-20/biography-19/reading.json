  "paragraph_notes": [
    {
      "start": 1635388,
      "end": 1635427,
      "context_start": 1635388,
      "context_end": 1635577,
      "reason": "العنوان الأصلي مستقل عن خبر ابن سعد الذي يليه."
    },
    {
      "start": 1635427,
      "end": 1635577,
      "context_start": 1635388,
      "context_end": 1635614,
      "reason": "المؤاخاة وذكر المشاهد خبران مترابطان في وصف عامر، ويتلوهما تعقيب صاحب النص بصيغة قلت."
    },
    {
      "start": 1635577,
      "end": 1635614,
      "context_start": 1635427,
      "context_end": 1635647,
      "reason": "التعقيب على شهود أربعة إخوة بدرًا مستقل بصيغة قلت بعد خبر المشاهد؛ لا يغير النفي أو نسبته إلى قائله."
    },
    {
      "start": 1635614,
      "end": 1635647,
      "context_start": 1635577,
      "context_end": 1635647,
      "reason": "خبر الاستشهاد يوم اليمامة يختم الترجمة بعد التعقيب عن بدر."
    }
  ],
  "criticism": []
}
