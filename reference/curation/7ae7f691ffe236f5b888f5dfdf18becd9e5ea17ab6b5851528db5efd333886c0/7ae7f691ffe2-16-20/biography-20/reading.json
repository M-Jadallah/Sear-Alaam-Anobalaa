  "paragraph_notes": [
    {
      "start": 1635647,
      "end": 1635701,
      "context_start": 1635647,
      "context_end": 1635824,
      "reason": "عنوان المصدر مستقل، ويتبعه تمام النسب ووصف الترجمة."
    },
    {
      "start": 1635701,
      "end": 1635824,
      "context_start": 1635647,
      "context_end": 1635952,
      "reason": "جمع تمام النسب والانتساب وخبر فقر مسطح ونفقة أبي بكر ضمن التعريف به؛ ينتقل بعده إلى نص ابن سعد."
    },
    {
      "start": 1635824,
      "end": 1635952,
      "context_start": 1635701,
      "context_end": 1636137,
      "reason": "وصل نسبة الخبر إلى ابن سعد بالوصف والعمر وتاريخ الوفاة الذي يعود فيه قال إليه، قبل تعقيب المؤلف."
    },
    {
      "start": 1635952,
      "end": 1636137,
      "context_start": 1635824,
      "context_end": 1636137,
      "reason": "جمع تحذيرَي المؤلف المتوازيين في شأن الهفوة والقذف؛ لكل منهما قيده وسياقه، ولا يفصل عن الآخر لمجرد علامة السطر."
    }
  ],
  "criticism": []
}
