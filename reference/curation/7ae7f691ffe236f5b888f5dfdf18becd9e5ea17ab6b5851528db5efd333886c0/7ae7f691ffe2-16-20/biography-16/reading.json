  "paragraph_notes": [
    {
      "start": 1633869,
      "end": 1633926,
      "context_start": 1633869,
      "context_end": 1634297,
      "reason": "عنوان المصدر مستقـل عن النسب الذي يليه."
    },
    {
      "start": 1633926,
      "end": 1634297,
      "context_start": 1633869,
      "context_end": 1634455,
      "reason": "الصيغة البديلة للنسب مع نقل ابن سعد للتسمية وأقوال المختلفين في نسبة الأب؛ يليه إسناد جديد."
    },
    {
      "start": 1634297,
      "end": 1634455,
      "context_start": 1633926,
      "context_end": 1634651,
      "reason": "سند محمد بن صالح ومتنه في إسلام الإخوة والمبايعة خبر متصل."
    },
    {
      "start": 1634455,
      "end": 1634651,
      "context_start": 1634297,
      "context_end": 1634811,
      "reason": "إسناد عبد الله بن أبي بكر ومتن خروج الأسرة ونزولها على رفاعة متصلان."
    },
    {
      "start": 1634651,
      "end": 1634811,
      "context_start": 1634455,
      "context_end": 1634899,
      "reason": "صيغة وقالوا قبل خبر المؤاخاة والقتل، مع ضم قول مجذر المخالف حتى لا يُحجب الاختلاف."
    },
    {
      "start": 1634811,
      "end": 1634899,
      "context_start": 1634651,
      "context_end": 1634907,
      "reason": "خبر استشهاد عاقل وعمره يليه تعيين قاتله؛ عائد قتله موصول بصاحبه."
    },
    {
      "start": 1634899,
      "end": 1634907,
      "context_start": 1634811,
      "context_end": 1634907,
      "reason": "عبارة أخوه في نهاية نطاق المصدر تمهيد صريح للترجمة التالية؛ تبقى حرفية مستقلة عن خبر الوفاة."
    }
  ],
