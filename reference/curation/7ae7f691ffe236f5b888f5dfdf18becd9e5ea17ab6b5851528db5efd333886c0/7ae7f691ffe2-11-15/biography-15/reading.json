  "paragraph_notes": [
    {
      "start": 1624053,
      "end": 1624112,
      "context_start": 1624053,
      "context_end": 1624314,
      "reason": "عنوان المصدر المستقل عن تكملة النسب والوصف."
    },
    {
      "start": 1624112,
      "end": 1624314,
      "context_start": 1624053,
      "context_end": 1624457,
      "reason": "تكملة النسب ووصف حمزة وصلته برسول الله تمهيد قبل خبر إسلامه."
    },
    {
      "start": 1624314,
      "end": 1624457,
      "context_start": 1624112,
      "context_end": 1624653,
      "reason": "خبر ابن إسحاق عن أثر إسلامه في موقف قريش قائم بذاته."
    },
    {
      "start": 1624457,
      "end": 1624653,
      "context_start": 1624314,
      "context_end": 1624901,
      "reason": "إسناد علي وسؤال صاحب الجمل وجواب حمزة ومبارزته متصلة."
    },
    {
      "start": 1624653,
      "end": 1624901,
      "context_start": 1624457,
      "context_end": 1625040,
      "reason": "رواية أسامة عن بكاء النساء ونهيهن تجمع الحوار رغم علامة الصفحة التي تقطع اليوم."
    },
    {
      "start": 1624901,
      "end": 1625040,
      "context_start": 1624653,
      "context_end": 1625263,
      "reason": "خبر المستدرك عن جابر مقرون بقول المؤلف سنده ضعيف؛ لا يفصل النقد عن الخبر."
    },
    {
      "start": 1625040,
      "end": 1625263,
      "context_start": 1624901,
      "context_end": 1625589,
      "reason": "طريق الدغولي عن جابر ولفظه المختصر مقرون بالتعقيب هذا غريب."
    },
    {
      "start": 1625263,
      "end": 1625589,
      "context_start": 1625040,
      "context_end": 1626362,
      "reason": "رواية أخرى لأسامة عن ابن عمر فيها رجوع النبي وحديث النساء واستيقاظه وأمره لهن."
    },
    {
      "start": 1625589,
      "end": 1626362,
      "context_start": 1625263,
      "context_end": 1627092,
      "reason": "إسناد ابن إسحاق ومقدمة لقاء وحشي وتعرفه إلى ابن الخيار وسؤاله عن مقتل حمزة؛ تستمر إجابته بعد هذه الفقرة."
    },
    {
      "start": 1626362,
      "end": 1627092,
      "context_start": 1625589,
      "context_end": 1627609,
      "reason": "يبدأ وحشي جوابَه بعرض شرط جبير، ثم يروي المبارزة ورمي الحربة وموت حمزة، والصفحة لا تقطع الشرط."
    },
    {
      "start": 1627092,
      "end": 1627609,
      "context_start": 1626362,
      "context_end": 1628002,
      "reason": "يستأنف وحشي سيرته بعد فتح مكة وخروجه إلى المدينة والحوار مع الرسول، متصلًا بخبر المقتل السابق."
    },
    {
      "start": 1627609,
      "end": 1628002,
      "context_start": 1627092,
      "context_end": 1628118,
      "reason": "يواصل وحشي حديثه عن مسيلمة ومشاركة الأنصاري وعدم الجزم بالقاتل، مع خاتمة قوله المشروطة."
    },
    {
      "start": 1628002,
      "end": 1628118,
      "context_start": 1627609,
      "context_end": 1628576,
      "reason": "طريق آخر عن ابن عمر وسماعه قول رجل في قتل مسيلمة يلي الرواية السابقة."
    },
    {
      "start": 1628118,
      "end": 1628576,
      "context_start": 1628002,
      "context_end": 1628730,
      "reason": "خبر أنس عن الوقوف على حمزة وكفنه وشهداء أحد وصلاتهم ودفنهم وحدة بإسناده."
    },
    {
      "start": 1628576,
      "end": 1628730,
      "context_start": 1628118,
      "context_end": 1628873,
      "reason": "رواية سعد عن قتال حمزة بسيفين مقترنة بإسنادها."
    },
    {
      "start": 1628730,
      "end": 1628873,
      "context_start": 1628576,
      "context_end": 1629438,
      "reason": "رواية يونس المرسلة والزيادة في العثرة والقتل ترتبط بالخبر السابق مع إبقاء وصف الإرسال."
    },
    {
      "start": 1628873,
      "end": 1629438,
      "context_start": 1628730,
      "context_end": 1629803,
      "reason": "الإسناد الثاني وخبر لقاء وحشي وتعرفه إلى ابن الخيار ثم سؤاله مقدمة لروايته التالية."
    },
    {
      "start": 1629438,
      "end": 1629803,
      "context_start": 1628873,
      "context_end": 1630090,
      "reason": "جواب وحشي عن شرط مولاه والمبارزة ورمي حمزة يشكل مرحلة متصلة من الرواية الثانية."
    },
    {
      "start": 1629803,
      "end": 1630090,
      "context_start": 1629438,
      "context_end": 1630482,
      "reason": "يستأنف وحشي خبر الطائف والحوار مع الرسول؛ علامة الصفحة لا تقطع السؤال."
    },
    {
      "start": 1630090,
      "end": 1630482,
      "context_start": 1629803,
      "context_end": 1630973,
      "reason": "خاتمة الرواية الثانية في الخروج لمسيلمة والرمي ثم سماع ابن عمر قول الجارية."
    },
    {
      "start": 1630482,
      "end": 1630973,
      "context_start": 1630090,
      "context_end": 1631380,
      "reason": "خبر موسى بن عقبة عن القتلى وحنظلة وقول أبيه ثم العثور على حمزة ودفنه متصل السياق."
    },
    {
      "start": 1630973,
      "end": 1631380,
      "context_start": 1630482,
      "context_end": 1631932,
      "reason": "إسناد ابن إسحاق وخبر التمثيل والآية والعفو متصلان؛ لا تفصل الصفحة لفظ رسول الله."
    },
    {
      "start": 1631380,
      "end": 1631932,
      "context_start": 1630973,
      "context_end": 1632080,
      "reason": "خبر صفية والصلاة على القتلى متصل بالتعقيب على يزيد ومقارنة قول جابر."
    },
    {
      "start": 1631932,
      "end": 1632080,
      "context_start": 1631380,
      "context_end": 1632218,
      "reason": "حديث عقبة في الصحيحين مع تعقيب توقيته قبل الوفاة يُقرأ بعد المقارنة السابقة."
    },
    {
      "start": 1632080,
      "end": 1632218,
      "context_start": 1631932,
      "context_end": 1632616,
      "reason": "رواية ابن عباس وأبي هريرة عن التمثيل ونزول الآية منفصلة بصيغة يروى."
    },
    {
      "start": 1632218,
      "end": 1632616,
      "context_start": 1632080,
      "context_end": 1632993,
      "reason": "إسناد أبي بن كعب وخبر قتلى أحد وفتح مكة والآية وأمر الكف متصل."
    },
    {
      "start": 1632616,
      "end": 1632993,
      "context_start": 1632218,
      "context_end": 1633517,
      "reason": "خبر صفية والثوبين والقرعة وكفن حمزة والأنصاري يشكل وحدة مستقلة."
    },
    {
      "start": 1632993,
      "end": 1633517,
      "context_start": 1632616,
      "context_end": 1633731,
      "reason": "إسناد ابن عباس وخبر أرواح شهداء أحد وحوارهم والآية التي تليه متصل."
    },
    {
      "start": 1633517,
      "end": 1633731,
      "context_start": 1632993,
      "context_end": 1633869,
      "reason": "خبر جابر عن تمني النبي مع أصحاب فحص الجبل يتصل بالتفسير قتلت معهم."
    },
    {
      "start": 1633731,
      "end": 1633869,
      "context_start": 1633517,
      "context_end": 1633869,
      "reason": "خبر جابر الأخير مصدّر بقيد ضعف إسناده، ويبقى القيد مع المتن."
    }
  ],
