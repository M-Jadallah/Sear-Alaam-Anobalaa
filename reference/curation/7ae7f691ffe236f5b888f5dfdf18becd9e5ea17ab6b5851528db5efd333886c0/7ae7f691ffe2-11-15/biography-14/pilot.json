  "segments": [
    {
      "segment_id": 8420,
      "assessment": "no_clear_topic",
      "note": "وصف سالم بالسبق وشهود بدر والقرب والعلم دون إسناد في هذا المقطع.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8421,
      "assessment": "no_clear_topic",
      "note": "رواية موسى بن عقبة عن أصله وولائه ومعتقته وتبني أبي حذيفة له مع تعقيب كذا قال.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8422,
      "assessment": "no_clear_topic",
      "note": "بداية إسناد ابن أبي مليكة عن القاسم قبل خبر سهلة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8423,
      "assessment": "no_clear_topic",
      "note": "تقديم سهلة وذكر صلتها بأبي حذيفة تمهيد لسؤالها.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8424,
      "assessment": "no_clear_topic",
      "note": "سؤال سهلة عن إقامة سالم معها بعد إدراكه الرجال، وهو جزء من الخبر.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8425,
      "assessment": "supported",
      "note": "جواب النبي لسهلة في الرضاع داخل سياق سؤالها، ويليه تقييد أزواجه.",
      "topics": [
        {
          "topic": "الرضاع",
          "category": "الفقه وأصوله",
          "aliases": [],
          "rationale": "جواب النبي لسهلة عن سالم في خبر الرضاع، مع حفظ موقف أزواج النبي وقولهن إن الرخصة خاصة به في السياق.",
          "relation_type": "discussion",
          "subject_scope": "general_context",
          "stance": "reported",
          "evidence_start": 1620042,
          "evidence_end": 1620095,
          "context_start": 1619851,
          "context_end": 1620239
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8426,
      "assessment": "no_clear_topic",
      "note": "موقف أزواج النبي من إدخال أحد بهذا الرضاع يليه بيان وجه الخصوص عندهن.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8427,
      "assessment": "no_clear_topic",
      "note": "قول أزواج النبي إن الرخصة خاصة بسالم؛ لا يعمم من غير سياقه.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8428,
      "assessment": "no_clear_topic",
      "note": "ابتداء رواية ابن عمر عن إمامة سالم.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8429,
      "assessment": "supported",
      "note": "خبر إمامة المهاجرين مقرون بأقرئية سالم عند قدومهم المدينة.",
      "topics": [
        {
