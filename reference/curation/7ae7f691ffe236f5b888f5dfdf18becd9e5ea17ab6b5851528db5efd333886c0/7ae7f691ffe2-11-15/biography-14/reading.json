  "paragraph_notes": [
    {
      "start": 1619592,
      "end": 1619625,
      "context_start": 1619592,
      "context_end": 1619678,
      "reason": "عنوان الترجمة الأصلي مستقل عن وصف صاحبها."
    },
    {
      "start": 1619625,
      "end": 1619678,
      "context_start": 1619592,
      "context_end": 1619851,
      "reason": "وصف افتتاحي لصاحب الترجمة قبل رواية أصله."
    },
    {
      "start": 1619678,
      "end": 1619851,
      "context_start": 1619625,
      "context_end": 1620239,
      "reason": "خبر موسى بن عقبة في الأصل والولاء والعتق والتبني يتصل بتعقيب كذا قال."
    },
    {
      "start": 1619851,
      "end": 1620239,
      "context_start": 1619678,
      "context_end": 1620359,
      "reason": "إسناد خبر سهلة وسؤالها والجواب ثم موقف أزواج النبي من الرضاع ورأيهن في خصوص الرخصة متصلان."
    },
    {
      "start": 1620239,
      "end": 1620359,
      "context_start": 1619851,
      "context_end": 1620509,
      "reason": "رواية ابن عمر عن إمامة سالم للمهاجرين وتعليلها بأقرئيتِه خبر مستقل."
    },
    {
      "start": 1620359,
      "end": 1620509,
      "context_start": 1620239,
      "context_end": 1620785,
      "reason": "رواية الواقدي بإسنادها عن إمامته بقباء تتضمن حضور عمر وتوقيت قدوم الرسول."
    },
    {
      "start": 1620509,
      "end": 1620785,
      "context_start": 1620359,
      "context_end": 1620988,
      "reason": "رواية عائشة وسؤال الرسول وجوابها وسماعه وتحميده مع حكم الإسناد المتصل بها وحدة واحدة."
    },
    {
      "start": 1620785,
      "end": 1620988,
      "context_start": 1620509,
      "context_end": 1621125,
      "reason": "إسناد ابن نمير ومتن نزول المهاجرين وإمامة سالم متصلان رغم علامة الصفحة الواقعة بعد كان."
    },
    {
      "start": 1620988,
      "end": 1621125,
      "context_start": 1620785,
      "context_end": 1621264,
      "reason": "طريق أسامة بن حفص ولفظه اللاحق منفصل بوصفه رواية أخرى للخبر."
    },
    {
      "start": 1621125,
      "end": 1621264,
      "context_start": 1620988,
      "context_end": 1621512,
      "reason": "خبر المؤاخاة مع تعقيب هذا منقطع ملحقًا به ولا يفصل عنه."
    },
    {
      "start": 1621264,
      "end": 1621512,
      "context_start": 1621125,
      "context_end": 1621643,
      "reason": "رواية الواقدي عن اليمامة تشمل قول سالم وحفره وحمله الراية وقتاله حتى قتل."
    },
    {
      "start": 1621512,
      "end": 1621643,
      "context_start": 1621264,
      "context_end": 1621750,
      "reason": "خبر بيع الميراث وإعطاء الأم المبلغ يتصل بالأمر كليها."
    },
    {
      "start": 1621643,
      "end": 1621750,
      "context_start": 1621512,
      "context_end": 1621780,
      "reason": "الخبر المصدّر بقيل عن مصرع سالم وأبي حذيفة مستقل ويحفظ صيغة التمريض."
    },
    {
      "start": 1621750,
      "end": 1621780,
      "context_start": 1621643,
      "context_end": 1622541,
      "reason": "تمهيد المصدر لمناقب سالم مستقل قبل إسناد الخبر التالي."
    },
    {
      "start": 1621780,
      "end": 1622541,
      "context_start": 1621750,
      "context_end": 1622541,
      "reason": "الإسناد الطويل وحديث عمر وسعيد في الخلافة وذكر الرجلين متصلان بنقد علي بن زيد والاستنتاج المشروط بصحة الخبر."
    }
  ],
  "criticism": [
    {
      "start": 1620773,
