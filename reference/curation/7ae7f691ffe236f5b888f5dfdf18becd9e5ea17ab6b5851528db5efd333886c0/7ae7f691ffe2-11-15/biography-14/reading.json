      "context_end": 1620785,
      "kind": "isnad",
      "reason": "تعقيب على إسناد خبر سماع قراءة سالم، يبقى مرتبطًا بمتنه."
    },
    {
      "start": 1621253,
      "end": 1621263,
      "context_start": 1621125,
      "context_end": 1621264,
      "kind": "isnad",
      "reason": "تعقيب الانقطاع على خبر المؤاخاة وليس حكمًا على جميع أخباره."
    },
    {
      "start": 1622417,
      "end": 1622432,
      "context_start": 1621780,
      "context_end": 1622541,
      "kind": "narrator",
      "reason": "تقويم علي بن زيد مع الاستنتاج المشروط بصحة الخبر في بقية الفقرة."
    }
  ]
