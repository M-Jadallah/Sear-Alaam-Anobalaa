    {
      "start": 1616972,
      "end": 1617019,
      "context_start": 1616972,
      "context_end": 1617136,
      "reason": "عنوان المصدر مستقل عن متن الترجمة؛ الخبر التالي يشرح السبق والمشاهد والهجرة."
    },
    {
      "start": 1617019,
      "end": 1617136,
      "context_start": 1616972,
      "context_end": 1617319,
      "reason": "يجمع الخبر الافتتاحي بين السبق والشهود والقرابة والهجرة؛ يبدأ بعده نقل ابن سعد المستقل."
    },
    {
      "start": 1617136,
      "end": 1617319,
      "context_start": 1617019,
      "context_end": 1617319,
      "reason": "يضم قول ابن سعد المشاهد والمؤاخاة ثم قول «قال» المتصل بشأن الوفاة؛ الضمير عائد إلى صاحب الترجمة والنقل لا ينقطع بعلامة الفقرة."
    }
  ],
