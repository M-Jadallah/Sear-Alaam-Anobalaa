  "segments": [
    {
      "segment_id": 8398,
      "assessment": "no_clear_topic",
      "note": "تعريف صاحب الترجمة وعمود نسبه وصفة البدري، مع اسم أبيه لا هوية إضافية مستنتجة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8399,
      "assessment": "no_clear_topic",
      "note": "يذكر سبقه واسمه على وجه القيل؛ القيد يمنع الجزم بالاسم.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8400,
      "assessment": "no_clear_topic",
      "note": "خبر إسلامه قبل دخول دار الأرقم يحدد ترتيبًا زمنيًا.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8401,
      "assessment": "supported",
      "note": "هجرته وولادة محمد بالحبشة؛ وصف الثورة يرجع إلى ابنه لا أبي حذيفة، والأم سهلة.",
      "topics": [
        {
          "topic": "الرحلات",
          "category": "التراجم والرجال",
          "aliases": [],
          "rationale": "يذكر هجرتين إلى الحبشة.",
          "relation_type": "event",
          "subject_scope": "biography_subject",
          "stance": "reported",
          "evidence_start": 1618176,
          "evidence_end": 1618198,
          "context_start": 1618174,
          "context_end": 1618327
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8402,
      "assessment": "supported",
      "note": "الحديث عن سهلة وزواجها وإرضاع سالم وتخصيص الحكم عند الجمهور؛ لا يُنسب إليها وحدها استنتاج فقهي زائد.",
      "topics": [
        {
          "topic": "النكاح والأسرة",
          "category": "الفقه وأصوله",
          "aliases": [],
          "rationale": "وصف إرضاع سالم وخصوص الحكم عند الجمهور، محفوظ بلفظه ولا يعمم.",
          "relation_type": "discussion",
          "subject_scope": "mentioned_person",
          "stance": "reported",
          "evidence_start": 1618361,
          "evidence_end": 1618439,
          "context_start": 1618174,
          "context_end": 1618446
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8403,
      "assessment": "supported",
      "note": "خبر أبي الزناد عن دعوته أباه إلى البراز؛ تتصل به أبيات أخته التالية.",
      "topics": [
        {
          "topic": "الفتن والحروب",
          "category": "التاريخ والمجتمع",
          "aliases": [],
          "rationale": "دعوة للمبارزة يوم بدر ضمن الخبر الذي تتبعه أبيات هند.",
          "relation_type": "event",
          "subject_scope": "biography_subject",
          "stance": "reported",
          "evidence_start": 1618485,
          "evidence_end": 1618512,
          "context_start": 1618446,
          "context_end": 1618686
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8404,
      "assessment": "no_clear_topic",
      "note": "تقديم هند أخت أبي حذيفة وقولها، وتمتد عبارتها إلى البيتين بعده.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8405,
      "assessment": "no_clear_topic",
      "note": "بيت هجاء تنسبه الرواية إلى هند؛ وصفها ليس حكمًا من المحرر على أبي حذيفة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8406,
      "assessment": "no_clear_topic",
      "note": "البيت الثاني يستكمل خطاب هند وعتابها السابق ولا يقرر برًا أو عقوقًا.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8407,
      "assessment": "no_clear_topic",
      "note": "شرح وصف الأثعل عقب الشعر ووصف صاحب الترجمة، وحسن الوجه صفة هيئة لا تصحيح حديث.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8408,
      "assessment": "supported",
      "note": "خبر استشهاده في اليمامة مع سالم وسنة اثنتي عشرة.",
      "topics": [
        {
          "topic": "الوفاة",
          "category": "التراجم والرجال",
          "aliases": [],
          "rationale": "ذكر استشهاده ووقته على ما جاء في المصدر.",
          "relation_type": "event",
          "subject_scope": "biography_subject",
          "stance": "reported",
          "evidence_start": 1618755,
          "evidence_end": 1618814,
          "context_start": 1618753,
          "context_end": 1618834
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8409,
      "assessment": "no_clear_topic",
      "note": "ينتقل إلى أخيه أبي هاشم وإسلامه وجهاده وسكناه وصلاحه؛ الضمائر له.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8410,
      "assessment": "no_clear_topic",
      "note": "الرواية والكتب الثلاثة تعود إلى أبي هاشم المذكور قبلها، لا إلى أبي حذيفة.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8411,
      "assessment": "no_clear_topic",
      "note": "وفاة أبي هاشم وقرابته لمصعب ومعاوية؛ لفظ الخليفة يذكره وصفًا للقرابة.",
      "topics": [],
      "existing_hits": [
        {
          "hit_id": 811,
          "decision": "exclude",
          "reason": "ورد لقب الخليفة لمعاوية في بيان القرابة، ولا يتناول النص الخلافة أو السياسة في هذا الموضع."
        }
      ]
    },
    {
      "segment_id": 8412,
      "assessment": "no_clear_topic",
      "note": "إسناد خبر سمرة عن زيارة أبي هاشم؛ يجب وصله بالمشهد والحوار التالي.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8413,
      "assessment": "no_clear_topic",
      "note": "سمرة يروي زيارة معاوية لخاله الطعين وبكاءه؛ تتصل الجملة بالسؤال التالي.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8414,
      "assessment": "no_clear_topic",
      "note": "سؤال معاوية لخاله عن سبب بكائه، ولا يحسم سببه قبل الجواب.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8415,
      "assessment": "no_clear_topic",
      "note": "جواب أبي هاشم ينفي الوجع والحرص ويبين خوفه من عدم العمل بالعهد.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8416,
      "assessment": "supported",
      "note": "يشرح أبو هاشم عهد النبي إليه في المال والكفاية؛ الكلام منقول في سياق الخبر.",
      "topics": [
        {
          "topic": "الزهد",
          "category": "القلب والسلوك",
          "aliases": [],
          "rationale": "وصية مروية في الاقتصار من جمع الدنيا، في خبر يرويه سمرة عن أبي هاشم.",
          "relation_type": "saying",
          "subject_scope": "mentioned_person",
          "stance": "reported",
          "evidence_start": 1619421,
          "evidence_end": 1619472,
          "context_start": 1619106,
          "context_end": 1619553
        }
      ],
      "existing_hits": []
    },
    {
      "segment_id": 8417,
      "assessment": "no_clear_topic",
      "note": "إقرار أبي هاشم بالجمع يكمل سبب بكائه في الحوار السابق.",
      "topics": [],
      "existing_hits": []
    },
    {
      "segment_id": 8418,
      "assessment": "no_clear_topic",
      "note": "صيغة أخرى مرسلة متعلقة بالخبر السابق؛ تحفظ صفة الإرسال ولا تحكم على الحديث.",
      "topics": [],
      "existing_hits": []
    },
    {
