  "paragraph_notes": [
    {
      "start": 1617900,
      "end": 1617955,
      "context_start": 1617900,
      "context_end": 1618327,
      "reason": "عنوان المصدر مستقل عن تعريف صاحب الترجمة اللاحق."
    },
    {
      "start": 1617955,
      "end": 1618327,
      "context_start": 1617900,
      "context_end": 1618446,
      "reason": "يضم التعريف والسبق والإسلام والهجرة والمولد سلسلة التعريف بأبي حذيفة وأسرته؛ ينتقل بعدها إلى خبر سهلة وحكم الرضاع."
    },
    {
      "start": 1618327,
      "end": 1618446,
      "context_start": 1617955,
      "context_end": 1618564,
      "reason": "خبر سهلة وإرضاع سالم وحكم الجمهور متصل بخبرها السابق، ويفصل عن رواية البراز التي تبدأ بعدها."
    },
    {
      "start": 1618446,
      "end": 1618564,
      "context_start": 1618327,
      "context_end": 1618626,
      "reason": "رواية أبي الزناد ودعوة الأب تتصل بتمهيد قول هند؛ يفصل بعدها مطلع البيت الأول محافظة على بنية الشعر."
    },
    {
      "start": 1618564,
      "end": 1618626,
      "context_start": 1618446,
      "context_end": 1618686,
      "reason": "البيت الأول من هجاء هند، يفصل عن البيت الثاني للشكل الشعري مع حفظ نسبة القول لها."
    },
    {
      "start": 1618626,
      "end": 1618686,
      "context_start": 1618564,
      "context_end": 1618753,
      "reason": "البيت الثاني يتم سؤال هند ويليه تفسير الأثعل؛ فصل البيت حد شعري لا انفصال في القول."
    },
    {
      "start": 1618686,
      "end": 1618753,
      "context_start": 1618626,
      "context_end": 1618834,
      "reason": "التفسير اللاحق يوضح وصف الأثعل في البيت، ثم ينتقل إلى خبر الاستشهاد المستقل."
    },
    {
      "start": 1618753,
      "end": 1618834,
      "context_start": 1618686,
      "context_end": 1619106,
      "reason": "خبر وفاة أبي حذيفة وسالم يختم الخبر عنه قبل الانتقال إلى إسلام أخيه أبي هاشم."
    },
    {
      "start": 1618834,
      "end": 1619106,
      "context_start": 1618753,
      "context_end": 1619553,
      "reason": "تتصل ترجمة أبي هاشم بإسلامه وروايته ووفاته وقرابته، ثم يبدأ سند خبر زيارته."
    },
    {
      "start": 1619106,
      "end": 1619553,
      "context_start": 1618834,
      "context_end": 1619592,
      "reason": "الإسناد ومشهد الزيارة والسؤال والجواب والعهد والإقرار والرواية المرسلة خبر واحد مترابط عن أبي هاشم."
    },
    {
      "start": 1619553,
      "end": 1619592,
      "context_start": 1619106,
      "context_end": 1619592,
      "reason": "العودة إلى عمر أبي حذيفة بصيغة القيل بعد انتهاء رواية أخيه."
    }
  ],
  "criticism": [
    {
      "start": 1619514,
      "end": 1619529,
      "context_start": 1619106,
      "context_end": 1619553,
      "kind": "isnad",
      "reason": "المصدر يصف الرواية البديلة بالإرسال، دون استنتاج حكم على الحديث."
    }
  ]
}
