  "paragraph_notes": [
    {
      "start": 1617319,
      "end": 1617365,
      "context_start": 1617319,
      "context_end": 1617441,
      "reason": "العنوان الأصلي مستقل قبل بدء النسب؛ يليه بيان أم صاحب الترجمة ونسبها."
    },
    {
      "start": 1617365,
      "end": 1617441,
      "context_start": 1617319,
      "context_end": 1617611,
      "reason": "ضم ذكر الأم ونسب أمها لأن الضمير في أمها يعود إلى خولة؛ يبدأ بعده خبر الهجرة."
    },
    {
      "start": 1617441,
      "end": 1617611,
      "context_start": 1617365,
      "context_end": 1617830,
      "reason": "يضم الخبر الهجرة والرمي والمؤاخاة ووصف حارثة؛ تنتهي الوحدة قبل نقل ابن سعد عن بدر."
    },
    {
      "start": 1617611,
      "end": 1617830,
      "context_start": 1617441,
      "context_end": 1617900,
      "reason": "جمع رواية الشهود وعدم ذكر ابن عقبة والقول المخالف وتعقيب ابن سعد عليها لأن الأخير يحكم على القول السابق؛ ينتقل بعدها الخبر للإصابة."
    },
    {
      "start": 1617830,
      "end": 1617900,
      "context_start": 1617611,
      "context_end": 1617900,
      "reason": "ضم الإصابة بالسهم وقول الموت منه لارتباط الضمير بالخبر السابق، وتختتم به الترجمة."
    }
  ],
  "criticism": [
    {
      "start": 1617821,
      "end": 1617828,
      "context_start": 1617722,
      "context_end": 1617830,
      "kind": "report",
      "reason": "نص ابن سعد يعقب على تعيين هشام من شهد بدرًا ويصفه بالوهم، لا حكم على حديث أو راوٍ بإطلاق."
    }
  ]
}
