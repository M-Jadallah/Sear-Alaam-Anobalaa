  "criticism": [
    {
      "start": 1517896,
      "end": 1517921,
      "context_start": 1517241,
      "context_end": 1518597,
      "kind": "hadith",
      "reason": "يبين النص اختلاف لفظ أبي يعلى في الحديث؛ لا يضاف لفظ إلى روايته."
    },
    {
      "start": 1522352,
      "end": 1522368,
      "context_start": 1522206,
      "context_end": 1522387,
      "kind": "narrator",
      "reason": "توثيق منقول لراويي الطريق، لا وصف لصاحب الترجمة."
    },
    {
      "start": 1525585,
      "end": 1525608,
      "context_start": 1525497,
      "context_end": 1526017,
      "kind": "narrator",
      "reason": "تحفظ الراوي المنقول في اتهام مروان محفوظ بنفيه، دون تبنيه أو نسبته إلى الزبير."
    },
    {
      "start": 1532653,
      "end": 1532676,
      "context_start": 1532039,
      "context_end": 1532677,
      "kind": "hadith",
      "reason": "غرابة وتفرد بالخبر كما نص المصدر، دون تحويل الغريب إلى حكم ضعف."
    },
    {
      "start": 1533144,
      "end": 1533227,
      "context_start": 1532677,
      "context_end": 1533228,
      "kind": "report",
      "reason": "تعيين الوقعة في تعليق المصدر يحتفظ بتحفظ إن شاء الله وسبب التأريخ."
    },
    {
      "start": 1533421,
      "end": 1533711,
      "context_start": 1533228,
      "context_end": 1533712,
      "kind": "isnad",
      "reason": "يبقى نقد الإرسال والنكارة مع كامل النهي عن الجزم بمصير الأتباع والتحفظ اللاحق؛ ليس حكمًا ينشئه التطبيق."
    },
    {
      "start": 1533994,
      "end": 1534041,
      "context_start": 1533851,
      "context_end": 1534042,
      "kind": "report",
      "reason": "ترجيح العمر المنقول يظل مع القول الذي يرجحه والسياق المخالف."
    },
    {
      "start": 1535052,
      "end": 1535068,
      "context_start": 1534892,
      "context_end": 1535154,
      "kind": "report",
      "reason": "تنبيه المصدر كذا هذه الرواية يرافق أرقام التركة والرواية الأخرى دون تصحيح الأرقام آليًا."
    }
  ],
  "paragraph_notes": [
    {
      "start": 1516215,
      "end": 1516277,
      "context_start": 1516215,
      "context_end": 1516552,
      "reason": "عنوان المصدر مستقل، وتبقى ألفاظ النسب الممتدة بعده في المتن دون تغيير عنوانه."
    },
    {
      "start": 1516277,
      "end": 1516552,
      "context_start": 1516215,
      "context_end": 1516890,
      "reason": "استكمال النسب والقرابة والحواريّة والسبق والشورى والعمر بطاقة افتتاحية واحدة؛ وصلت الوصف بالنسب دون قطع الأخبار المسندة اللاحقة."
    },
    {
      "start": 1516552,
      "end": 1516890,
      "context_start": 1516277,
      "context_end": 1516986,
      "reason": "طريق الليث عن عروة خبر إسلامه وخروجه بالسيف وحواره عند الخبر بمكة؛ يبقى السند والحوار متصلين عبر الصفحة."
    },
    {
      "start": 1516890,
      "end": 1516986,
      "context_start": 1516552,
      "context_end": 1517241,
      "reason": "وصف الطول وخفة اللحية خبر هيئة مستقل عن رواية حمل السيف قبله."
    },
    {
      "start": 1516986,
      "end": 1517241,
      "context_start": 1516890,
      "context_end": 1517934,
      "reason": "عدد الروايات وأسماء من حدثوا عنه وإحصاء الصحيحين وحدة تعريف بالرواية، لا أخبار مواقف منفصلة."
    },
    {
      "start": 1517241,
      "end": 1517934,
      "context_start": 1516986,
      "context_end": 1518597,
      "reason": "السندان المجتمعان إلى شعبة يرويان سؤال الابن عن قلة التحديث وجواب أبيه؛ تحفظ لفظة متعمدا وقيد سقوطها من طريق أبي يعلى مع الحديث."
    },
    {
      "start": 1517934,
      "end": 1518597,
      "context_start": 1517241,
      "context_end": 1518708,
      "reason": "الطريق الثاني لسؤال الابن وجواب أبيه يتصل بتخريج طريق شعبة والمتابعة، دون الفصل عند التحويل في الإسناد."
    },
    {
      "start": 1518597,
      "end": 1518708,
      "context_start": 1517934,
      "context_end": 1518758,
      "reason": "قول موسى بن طلحة يجمع المقارنة في سنة الميلاد وتعليل ولدوا في سنة؛ لم أحسم لفظ عذار بالضبط."
    },
    {
      "start": 1518708,
      "end": 1518758,
      "context_start": 1518597,
      "context_end": 1518897,
      "reason": "نقل المدائني في كونهم أترابا مستقل النسبة عن النقل السابق، وإن اشتركا في معنى تقارب الأعمار."
    },
    {
      "start": 1518758,
      "end": 1518897,
      "context_start": 1518708,
      "context_end": 1519080,
      "reason": "خبر يتيم عروة عن الهجرة وتعذيب العم والقول برفض الكفر موقف واحد مع سياق عمره."
    },
    {
      "start": 1518897,
      "end": 1519080,
      "context_start": 1518758,
      "context_end": 1519168,
      "reason": "رواية عروة في حمل السيف تحفظ أسئلة النبي وجواب الزبير والدعاء للسيف في فقرة متصلة."
    },
    {
      "start": 1519080,
      "end": 1519168,
      "context_start": 1518897,
      "context_end": 1519248,
      "reason": "نقل هشام عن هيئة الطول والشعر رواية وصف مستقلة عن حوار السيف."
    },
    {
      "start": 1519168,
      "end": 1519248,
      "context_start": 1519080,
      "context_end": 1519297,
      "reason": "خبر ضرب صفية لابنها يمهد لقولها الشعري التالي؛ ينتهي قبل البيت صونًا لحد الشعر."
    },
    {
      "start": 1519248,
      "end": 1519297,
      "context_start": 1519168,
      "context_end": 1519372,
      "reason": "بيت صفية يفسر مقصد تأديب الابن وجَرّ الجيش؛ يحفظ كشعر مستقل دون تصحيح وزن أو ألفاظ."
    },
    {
      "start": 1519297,
      "end": 1519372,
      "context_start": 1519248,
      "context_end": 1519406,
      "reason": "حادثة كسر يد الغلام وسؤال صفية تمهد للقول الشعري التالي، وهي خبر مستقل عن تعليل التأديب الأول."
    },
    {
      "start": 1519372,
      "end": 1519406,
      "context_start": 1519297,
      "context_end": 1519427,
      "reason": "الشطر الذي يقابل الوبر بالأقط والتمر محفوظ في قطعة شعر مستقلة."
    },
    {
      "start": 1519406,
      "end": 1519427,
      "context_start": 1519372,
      "context_end": 1519527,
      "reason": "تتمة الوصف بالصقر تحفظ كشعر ولا تحسم الكلمة النادرة مشمعلا بالتخمين."
    },
    {
      "start": 1519427,
      "end": 1519527,
      "context_start": 1519406,
      "context_end": 1519615,
      "reason": "نقل ابن إسحاق عن الإسلام على يد أبي بكر قائمة أسماء داخل رواية واحدة، لا أسانيد مستقلة."
    },
    {
      "start": 1519527,
      "end": 1519615,
      "context_start": 1519427,
      "context_end": 1519828,
      "reason": "خبر عمر بن مصعب عن سنه في القتال يبقى متصلًا رغم وقوع الصفحة بين سبع وعشرة."
    },
    {
      "start": 1519615,
      "end": 1519828,
      "context_start": 1519527,
      "context_end": 1519936,
      "reason": "إسناد أسد وجامع إلى البهي يقدّم خبر الفارسين في بدر والميمنة والميسرة بوحدة واحدة."
    },
    {
      "start": 1519828,
      "end": 1519936,
      "context_start": 1519615,
      "context_end": 1520112,
      "reason": "طريق هشام يذكر العمامة الصفراء وسيماء جبريل؛ لا يدمج مع الطريق المختلف بعده لمجرد اشتراك المعنى."
    },
    {
      "start": 1519936,
      "end": 1520112,
      "context_start": 1519828,
      "context_end": 1520160,
      "reason": "طريق الزبير بن بكار يذكر الملائكة والعمامة بإسناد مستقل، مع حفظه اقتراحًا منقولًا لا حكمًا من المحرر."
    },
    {
      "start": 1520112,
      "end": 1520160,
      "context_start": 1519936,
      "context_end": 1520215,
      "reason": "جملة تقديم شعر عامر بن صالح تبقى نثرًا يهيئ للأبيات ولا تدخل في البيت."
    },
    {
      "start": 1520160,
      "end": 1520215,
      "context_start": 1520112,
      "context_end": 1520272,
      "reason": "بيت عامر عن القرابة والفروسية محفوظ كشعر مع الشطرين."
    },
    {
      "start": 1520215,
      "end": 1520272,
      "context_start": 1520160,
      "context_end": 1520327,
      "reason": "بيت بدر واللباس الأصفر محفوظ، ويبقى الرسم اللامة بلا تصحيح همزة أو ضبط متوهم."
    },
    {
      "start": 1520272,
      "end": 1520327,
      "context_start": 1520215,
      "context_end": 1520419,
      "reason": "بيت الملائك ونصرة يوم تألب الأعداء محفوظ ضمن القصيدة، مع إبقاء حد البيت."
    },
    {
      "start": 1520327,
      "end": 1520419,
      "context_start": 1520272,
      "context_end": 1520940,
      "reason": "خبر الهجرة إلى الحبشة وتقييد قصر الإقامة نقل مستقل عن الشعر السابق."
    },
    {
      "start": 1520419,
      "end": 1520940,
      "context_start": 1520327,
      "context_end": 1521273,
      "reason": "حديث عائشة يجمع الآيات وخبر تعقب المشركين وقصد إظهار القوة ونتيجته؛ لا تفصل الآية عن تفسير الموقف."
    },
    {
      "start": 1520940,
      "end": 1521273,
      "context_start": 1520419,
      "context_end": 1521409,
      "reason": "خبر جابر في الخندق يجمع طلب الاستطلاع ثلاث مرات والجواب والحواريّة وتخريجه، لا فقرة لكل أنا أو قال."
    },
    {
      "start": 1521273,
      "end": 1521409,
      "context_start": 1520940,
      "context_end": 1521545,
      "reason": "طريق ابن الزبير في الحواريّة مستقل بإسناده عن طريق جابر السابق."
    },
    {
      "start": 1521409,
      "end": 1521545,
      "context_start": 1521273,
      "context_end": 1521693,
      "reason": "طريق أبي معاوية عن جابر يذكر القرابة والحواريّة، ويحتفظ بإسناده ونصه مستقلين."
    },
    {
      "start": 1521545,
      "end": 1521693,
      "context_start": 1521409,
      "context_end": 1521993,
      "reason": "طريق يونس عن هشام يروي الأخذ باليد والقول، وهو خبر مستقل لا تتمة لسند الطريق السابق."
    },
    {
      "start": 1521693,
      "end": 1521993,
      "context_start": 1521545,
      "context_end": 1522069,
      "reason": "خبر استئذان ابن جرموز ورد علي ولفظ الحواريّة يتصل بمتابعة شيبان وحماد، ويحفظ الصفحة الواقعة داخل الإسناد."
    },
    {
      "start": 1521993,
      "end": 1522069,
      "context_start": 1521693,
      "context_end": 1522206,
      "reason": "طريق جرير عن أم موسى إحالة مستقلة إلى خبر الاستئذان، فلا تضيع نسبته بدمجه في السند السابق."
    },
    {
      "start": 1522069,
      "end": 1522206,
      "context_start": 1521993,
      "context_end": 1522387,
      "reason": "رواية مرثد عن الحواري من الرجال والنساء تبقى خبرًا مسندًا غير محكوم بصحته من اللون."
    },
    {
      "start": 1522206,
      "end": 1522387,
      "context_start": 1522069,
      "context_end": 1522479,
      "reason": "خبر سماع ابن عمر نداء ابن الحواري وجوابه والتوثيق يتصل بتفسير الناصر؛ لا يفصل التفسير عن موضوعه."
    },
    {
      "start": 1522387,
      "end": 1522479,
      "context_start": 1522206,
      "context_end": 1522590,
      "reason": "التفسيران المنسوبان لمصعب والكلبي للحواري وحدة لغوية، مع حفظ القائلين المختلفين."
    },
    {
      "start": 1522479,
      "end": 1522590,
      "context_start": 1522387,
      "context_end": 1523015,
      "reason": "طريق هشام المختصر في جمع الأبوين يظل مستقلًا عن الطريق المطول اللاحق."
    },
    {
      "start": 1522590,
      "end": 1523015,
      "context_start": 1522479,
      "context_end": 1523307,
      "reason": "الإسناد المطول إلى حماد وحوار الأب والابن ولفظ فداك أبي وأمي خبر واحد، مع صفحة لا تقطع السند."
    },
    {
      "start": 1523015,
      "end": 1523307,
      "context_start": 1522590,
      "context_end": 1523524,
      "reason": "رواية الأطم تصف رفع الغلامين بعضهما ومعرفة الأب العابر إلى قريظة؛ تحفظ داخل خبر ابن الزبير المتصل."
    },
    {
      "start": 1523307,
      "end": 1523524,
      "context_start": 1523015,
      "context_end": 1523737,
      "reason": "خبر ضرب المغفر والتعجب من السيف ثم بيان قصد العمل لليد يحتفظ بالجواب وتعقيبه."
    },
    {
      "start": 1523524,
      "end": 1523737,
      "context_start": 1523307,
      "context_end": 1523903,
      "reason": "إسناد أبي خيثمة يروي نقل اللواء يوم الفتح، وهو خبر مستقل عن المغفر."
    },
    {
      "start": 1523737,
      "end": 1523903,
      "context_start": 1523524,
      "context_end": 1524068,
      "reason": "خبر أسماء عن الساعدين وتخريجه بطريق ابن لهيعة يبقي التخريج مع المتن."
    },
    {
      "start": 1523903,
      "end": 1524068,
      "context_start": 1523737,
      "context_end": 1524210,
      "reason": "رواية علي بن حرب في لباس الحرير والقز تبقى متصلة، والكلمة النادرة يلمق معلقة للضبط."
    },
    {
      "start": 1524068,
      "end": 1524210,
      "context_start": 1523903,
      "context_end": 1524277,
      "reason": "قول الزبير في عدم التخلف عن الغزو يتصل بتقييد من لقيهم عند الإقبال، وتبقى يعقبون بلا حسم صرفي."
    },
    {
      "start": 1524210,
      "end": 1524277,
      "context_start": 1524068,
      "context_end": 1524377,
      "reason": "نقل الثوري في نجدة الثلاثة وصف موجز مستقل القائل."
    },
    {
      "start": 1524277,
      "end": 1524377,
      "context_start": 1524210,
      "context_end": 1524705,
      "reason": "رواية حماد في آثار الطعن والرمي وصف جسدي مسند، لا امتداد إسنادي لنقل الثوري."
    },
    {
      "start": 1524377,
      "end": 1524705,
      "context_start": 1524277,
      "context_end": 1524736,
      "reason": "خبر معمر في الضربات يتصل بسؤال عبد الملك عن السيف وذكر الفلة؛ يتوقف قبل البيت المستشهد به."
    },
    {
      "start": 1524705,
      "end": 1524736,
      "context_start": 1524377,
      "context_end": 1524826,
      "reason": "الشاهد الشعري بهن فلول يحتفظ بحده، ولا يستنتج قائل غير مذكور هنا."
    },
    {
      "start": 1524736,
      "end": 1524826,
      "context_start": 1524705,
      "context_end": 1525050,
      "reason": "عودة النثر بعد الشعر تكمل خبر السيف وتقديره والثمن وتمني أخذه، فلا تحذف لفصل البيت."
    },
    {
      "start": 1524826,
      "end": 1525050,
      "context_start": 1524736,
      "context_end": 1525143,
      "reason": "حديث حراء يجمع الحركة والأمر بالسكون وأسماء من عليه، دون جعل الأسماء قائمة مستحدثة."
    },
    {
      "start": 1525050,
      "end": 1525143,
      "context_start": 1524826,
      "context_end": 1525300,
      "reason": "الطريق الإضافي لحديث حراء يبين زيادة علي، ويحفظ نسبته المنفصلة."
    },
    {
      "start": 1525143,
      "end": 1525300,
      "context_start": 1525050,
      "context_end": 1525497,
      "reason": "الإحالة إلى تراجم السابقين وحديث الجوار في الجنة تبقى متصلة بصفحة جاءت بين التقديم والمتن."
    },
    {
      "start": 1525300,
      "end": 1525497,
      "context_start": 1525143,
      "context_end": 1526017,
      "reason": "نقل عمر في أمر الشورى يذكر شرط الحدث والستة وتسمية النبي لهم، مع حفظ تقييد الرضا."
    },
    {
      "start": 1525497,
      "end": 1526017,
      "context_start": 1525300,
      "context_end": 1526143,
      "reason": "حوار مرض الرعاف والاستخلاف وتفضيل الزبير يظل وحدة خبر تتبعها الرواية المختصرة، دون نسبة ذلك إلى كل فقرات الترجمة."
    },
    {
      "start": 1526017,
      "end": 1526143,
      "context_start": 1525497,
      "context_end": 1526310,
      "reason": "قول عمر في العهد والتركة وركن الدين خبر مستقل مع استمرار خبره عبر الصفحة."
    },
    {
      "start": 1526143,
      "end": 1526310,
      "context_start": 1526017,
      "context_end": 1526539,
      "reason": "خبر الوصايا السبعة وإنفاقه من ماله وحفظ أموال الورثة وحدة واحدة تبين الفعل المقصود."
    },
    {
      "start": 1526310,
      "end": 1526539,
      "context_start": 1526143,
      "context_end": 1526684,
      "reason": "خبر الخروج لمصر والتحذير من الطاعون والجواب والطعنة وتمامه وحدة سياقية مستقلة."
    },
    {
      "start": 1526539,
      "end": 1526684,
      "context_start": 1526310,
      "context_end": 1526895,
      "reason": "سؤال خفة الصلاة وجواب مبادرة الوسواس حوار واحد مع إسناده."
    },
    {
      "start": 1526684,
      "end": 1526895,
      "context_start": 1526539,
      "context_end": 1527363,
      "reason": "خبر ألف المملوك والخراج يتصل بنفي إدخاله بيته وزيادة التصدق؛ لا يفصل النفي عن موضوع المال."
    },
    {
      "start": 1526895,
      "end": 1527363,
      "context_start": 1526684,
      "context_end": 1527420,
      "reason": "خبر مجلس حسان وعدم الإنصات وموقف الزبير يمهد للمدح الشعري، وينتهي عند بداية البيت."
    },
    {
      "start": 1527363,
      "end": 1527420,
      "context_start": 1526895,
      "context_end": 1527475,
      "reason": "بيت مدح الزبير على عهد النبي وهديه محفوظ مستقلًا دون توليد عنوان مصدر."
    },
    {
      "start": 1527420,
      "end": 1527475,
      "context_start": 1527363,
      "context_end": 1527536,
      "reason": "بيت المنهاج وموالاة الحق يحتفظ بحده داخل القصيدة."
    },
    {
      "start": 1527475,
      "end": 1527536,
      "context_start": 1527420,
      "context_end": 1527601,
      "reason": "بيت الفارس والبطل ويوم الحرب محفوظ بالشطرين."
    },
    {
      "start": 1527536,
      "end": 1527601,
      "context_start": 1527475,
      "context_end": 1527658,
      "reason": "بيت الحرب والسيف الأبيض يحفظ صورته الشعرية ولا يصحح ألفاظه النادرة."
    },
    {
      "start": 1527601,
      "end": 1527658,
      "context_start": 1527536,
      "context_end": 1527717,
      "reason": "بيت صفية وأسد محفوظ بحد البيت مع إبقاء النسب كما ورد."
    },
    {
      "start": 1527658,
      "end": 1527717,
      "context_start": 1527601,
      "context_end": 1527788,
      "reason": "بيت القرابة والنصرة والمجد يحتفظ بصيغته الشعرية."
    },
    {
      "start": 1527717,
      "end": 1527788,
      "context_start": 1527658,
      "context_end": 1527856,
      "reason": "بيت كربات السيف والدفاع عن المصطفى يحتفظ بإحالة الصفحة في موضعها."
    },
    {
      "start": 1527788,
      "end": 1527856,
      "context_start": 1527717,
      "context_end": 1527975,
      "reason": "بيت الثناء والفعل يختم المدح، وتبقى علامة ms تقنية لا جزءًا من البيت."
    },
    {
      "start": 1527856,
      "end": 1527975,
      "context_start": 1527788,
      "context_end": 1528106,
      "reason": "بيع الدار وقول غبنت وجواب السبيل خبر مستقل يجمع الحوار وسببه."
    },
    {
      "start": 1527975,
      "end": 1528106,
      "context_start": 1527856,
      "context_end": 1528472,
      "reason": "نقل المحو من الديوان يوازي حال الأب والابن عند مقتل الخليفتين داخل خبر واحد."
    },
    {
      "start": 1528106,
      "end": 1528472,
      "context_start": 1527975,
      "context_end": 1528763,
      "reason": "سؤال مطرف عن الخليفة والدم وجواب الزبير بالآية والاعتراف بالدخول في الفتنة وحدة خبر، فلا يفصل العتاب عن الرد."
    },
    {
      "start": 1528472,
      "end": 1528763,
      "context_start": 1528106,
      "context_end": 1529159,
      "reason": "الحوار عن قتل علي يروى معه رفض الفتك والحديث المقيد له عبر الصفحة، دون تحويل الاقتراح إلى فعل ثابت."
    },
    {
      "start": 1528763,
      "end": 1529159,
      "context_start": 1528472,
      "context_end": 1529403,
      "reason": "خبر علي والزبير والحديث المذكر وانصراف الزبير رواية واحدة تحفظ الأسئلة واليمين والنتيجة."
    },
    {
      "start": 1529159,
      "end": 1529403,
      "context_start": 1528763,
      "context_end": 1529744,
      "reason": "طريق ابن عباس ينقل سؤال القتال ثم زيادة طريق آخر ورجوع الزبير؛ يبقى تركيب تملك الملك معلق الضبط."
    },
    {
      "start": 1529403,
      "end": 1529744,
      "context_start": 1529159,
      "context_end": 1530124,
      "reason": "القول المنسوب لعلي في خمسة أشخاص يبقى منقولًا بسنده؛ لا تجعل الأوصاف أحكامًا تحريرية على الأعلام."
    },
    {
      "start": 1529744,
      "end": 1530124,
      "context_start": 1529403,
      "context_end": 1530377,
      "reason": "طريق الرقاشي في التذكير والاعتراف والانصراف يتصل بالتخريج وذكر وجوه الرواية."
    },
    {
      "start": 1530124,
      "end": 1530377,
      "context_start": 1529744,
      "context_end": 1530449,
      "reason": "طريق ابن أبي ليلى يجمع عتاب الابن بجواب الأب ويمهد للبيت، ولا يفصل حلفه عن سببه."
    },
    {
      "start": 1530377,
      "end": 1530449,
      "context_start": 1530124,
      "context_end": 1530467,
      "reason": "بيت ترك الأمور وخشية العواقب محفوظ بحده الشعري."
    },
    {
      "start": 1530449,
      "end": 1530467,
      "context_start": 1530377,
      "context_end": 1530525,
      "reason": "تقديم وقيل إنه أنشد يفرق بين النقلين ولا ينسب البيت التالي جزمًا إلى القائل الأول."
    },
    {
      "start": 1530467,
      "end": 1530525,
      "context_start": 1530449,
      "context_end": 1530555,
      "reason": "البيت في قرب الممات محفوظ برسم ان الأصلي دون إضافة همزة أو حسم وجهه."
    },
    {
      "start": 1530525,
      "end": 1530555,
      "context_start": 1530467,
      "context_end": 1531163,
      "reason": "خاتمة فلم ينشب تعود من الشعر إلى نتيجة الخبر، مع حفظ ترتيبها قبل رواية أخرى للمقتل."
    },
    {
      "start": 1530555,
      "end": 1531163,
      "context_start": 1530525,
      "context_end": 1531460,
      "reason": "رواية حصين عن سفوان تضم الذمة وكلام الأحنف وسماع طالبيه والمعركة الأخيرة؛ الحوار والنفي والسياق في فقرة خبر متصل."
    },
    {
      "start": 1531163,
      "end": 1531460,
      "context_start": 1530555,
      "context_end": 1531670,
      "reason": "طريق عبيد الله في طعنه ودفنه وبكاء علي مستقل بإسناده عن خبر حصين."
    },
    {
      "start": 1531460,
      "end": 1531670,
      "context_start": 1531163,
      "context_end": 1532039,
      "reason": "طريق قرة في إتيان الرأس وقول علي والحديث يبقى منقولًا بسنده، دون حكم حديثي مولد."
    },
    {
      "start": 1531670,
      "end": 1532039,
      "context_start": 1531460,
      "context_end": 1532677,
      "reason": "قول الشعبي في الأربعة وتعليق المؤلف في السابقة والشهادة والمحبة وحدة حجاجية، لا يفصل الاستدلال عن المنقول."
    },
    {
      "start": 1532039,
      "end": 1532677,
      "context_start": 1531670,
      "context_end": 1533228,
      "reason": "خبر بدر والحربة يتصل بتاريخ انتقالها وتفرد البخاري؛ لا يفصل غريب وتفرد عن الرواية المقصودة."
    },
    {
      "start": 1532677,
      "end": 1533228,
      "context_start": 1532039,
      "context_end": 1533712,
      "reason": "رواية الهجوم والضربات ثم تعيين الوقعة باليمامة تعليق مؤثر ملحق بالخبر، لا يبرز الخبر دون تعيينه وتقييده."
    },
    {
      "start": 1533228,
      "end": 1533712,
      "context_start": 1532677,
      "context_end": 1533723,
      "reason": "رواية قائد الفتنة يتلوها نقد الإرسال والنكارة وتفويض المصير؛ أبقيت التحفظ كله دون تحويل الكلام المنقول إلى حكم محرر."
    },
    {
      "start": 1533712,
      "end": 1533723,
      "context_start": 1533228,
      "context_end": 1533789,
      "reason": "تقديم المرثية يبقى نثرًا منفصلًا عن أول البيت."
    },
    {
      "start": 1533723,
      "end": 1533789,
      "context_start": 1533712,
      "context_end": 1533851,
      "reason": "بيت الرزية ووادي السباع محفوظ، وتبقى حركة قبره معلقة لتردد وجه التركيب الشعري."
    },
    {
      "start": 1533789,
      "end": 1533851,
      "context_start": 1533723,
      "context_end": 1533942,
      "reason": "بيت المدينة والجبال يختم المرثية ويحتفظ بحده وإحالة الحاشية."
    },
    {
      "start": 1533851,
      "end": 1533942,
      "context_start": 1533789,
      "context_end": 1534042,
      "reason": "تاريخ القتل عند البخاري وغيره وتحديد موضع الوادي وحدة إحالة تاريخية موجزة."
    },
    {
      "start": 1533942,
      "end": 1534042,
      "context_start": 1533851,
      "context_end": 1534157,
      "reason": "اختلاف تقدير السن محفوظ مع قائليه وترجيح وهو أشبه دون تصحيح سنة مخزنة."
    },
    {
      "start": 1534042,
      "end": 1534157,
      "context_start": 1533942,
      "context_end": 1534489,
      "reason": "خبر الزوجات أسماء وأوصاف داخل نقل القحذمي، ويبقى ضبط اسم ناقله غير محسوم."
    },
    {
      "start": 1534157,
      "end": 1534489,
      "context_start": 1534042,
      "context_end": 1534892,
      "reason": "حوار ابن جرموز ومصعب ومشاورة أخيه ورد القتل يتصل بتعليق الندم والاستغفار، دون حذف المقارنة النقدية."
    },
    {
      "start": 1534489,
      "end": 1534892,
      "context_start": 1534157,
      "context_end": 1535069,
      "reason": "الطريق الآخر في سجن ابن جرموز وتسريحه ثم القصر والمنام خبر واحد، ويحفظ الصفحة بين القصر والأزج."
    },
    {
      "start": 1534892,
      "end": 1535069,
      "context_start": 1534489,
      "context_end": 1535154,
      "reason": "تقدير الأموال في طريق ابن قتيبة يبقى مع تحفظ كذا هذه الرواية، فلا يعرض العدد كرقم محقق."
    },
    {
      "start": 1535069,
      "end": 1535154,
      "context_start": 1534892,
      "context_end": 1535901,
      "reason": "طريق ابن عيينة يورد تقديرًا آخر للمال، مستقل النسبة عن الرواية السابقة."
    },
    {
      "start": 1535154,
      "end": 1535901,
      "context_start": 1535069,
      "context_end": 1536312,
      "reason": "حديث وصية الدين يبدأ بموقف الجمل ويضم الحوار في المولى وتفسيره بالدعاء، فلا يفصل الطلب عن تفسير المرجع."
    },
    {
      "start": 1535901,
      "end": 1536312,
      "context_start": 1535154,
      "context_end": 1536573,
      "reason": "حصر ما تركه ثم تفسير سبب الدين ونفي الولايات والخراج وحساب الدين وحدة تفسير مالي متصلة."
    },
    {
      "start": 1536312,
      "end": 1536573,
      "context_start": 1535901,
      "context_end": 1536901,
      "reason": "حوار حكيم وابن الزبير عن مقدار الدين والعجز يظل متصلًا، لأن إخفاء المقدار ثم تصحيحه لازم لفهمه."
    },
    {
      "start": 1536573,
      "end": 1536901,
      "context_start": 1536312,
      "context_end": 1537197,
      "reason": "خبر بيع الغابة وطلب أصحاب الدين وحوار ابن جعفر يبين الوفاء وتقسيم الأرض في سياق واحد."
    },
    {
      "start": 1536901,
      "end": 1537197,
      "context_start": 1536573,
      "context_end": 1537560,
      "reason": "خبر الأسهم يجمع المشترين وأقوالهم حتى بيع ابن جعفر نصيبه؛ لا يجعل كل قال فقرة منفردة."
    },
    {
      "start": 1537197,
      "end": 1537560,
      "context_start": 1536901,
      "context_end": 1537671,
      "reason": "الامتناع من القسمة والإعلان أربع سنين ثم القسمة والأنصباء وحدة خبر مالي؛ تحافظ الصفحة على اتصال اليمين بما بعدها."
    },
    {
      "start": 1537560,
      "end": 1537671,
      "context_start": 1537197,
      "context_end": 1537780,
      "reason": "إحصاء أحاديث المسند والصحيحين معلومة رواية مستقلة بعد خبر الميراث."
    },
    {
      "start": 1537671,
      "end": 1537780,
      "context_start": 1537560,
      "context_end": 1537795,
      "reason": "نقل حصة عاتكة في الميراث يهيئ لرثائها التالي ويحفظ الرفع في حصة على أنها الفاعل."
    },
    {
      "start": 1537780,
      "end": 1537795,
      "context_start": 1537671,
      "context_end": 1537851,
      "reason": "تقديم وقالت ترثيه يربط الأبيات بعاتكة دون إدخال كلام المحرر في الشعر."
    },
    {
      "start": 1537795,
      "end": 1537851,
      "context_start": 1537780,
      "context_end": 1537910,
      "reason": "بيت غدر ابن جرموز وفارس البهمة بداية المرثية محفوظة."
    },
    {
      "start": 1537851,
      "end": 1537910,
      "context_start": 1537795,
      "context_end": 1537965,
      "reason": "بيت نبهته ينفي الطيش والرعش، ولا يختزل طرف النفي في الإبراز."
    },
    {
      "start": 1537910,
      "end": 1537965,
      "context_start": 1537851,
      "context_end": 1538032,
      "reason": "بيت ثكلتك يدعو على القاتل ويحفظ سياق الرثاء، لا حكمًا من واجهة القراءة."
    },
    {
      "start": 1537965,
      "end": 1538032,
      "context_start": 1537910,
      "context_end": 1538102,
      "reason": "بيت الغمرات والطراد محفوظ بلفظه ولو ندر بعض ألفاظه، دون إصلاح الوزن."
    },
    {
      "start": 1538032,
      "end": 1538102,
      "context_start": 1537965,
      "context_end": 1538102,
      "reason": "بيت الختام يقرر خطاب المرثية للقاتل ويحفظ موضع الصفحة والحاشية."
    }
  ],
