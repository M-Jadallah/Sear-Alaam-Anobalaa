  "heading_labels": [
    {
      "at": 1604840,
      "label": "قُدُومُ مُصْعَبٍ مَعَ الْمُهَاجِرِينَ"
    },
    {
      "at": 1605085,
      "label": "خَبَرُ خَبَّابٍ عَنِ الْهِجْرَةِ وَالْكَفَنِ"
    },
    {
      "at": 1605489,
      "label": "بُكَاءُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ"
    },
    {
      "at": 1605768,
      "label": "بُرْدَةُ مُصْعَبٍ وَالْحِوَارُ عَنِ الْعَيْشِ"
    },
    {
      "at": 1606283,
      "label": "شِدَّةُ الْعَيْشِ بَعْدَ الْهِجْرَةِ"
    },
    {
      "at": 1606919,
      "label": "قِتَالُ مُصْعَبٍ وَمَقْتَلُهُ"
    }
  ],
  "paragraph_notes": [
    {
      "start": 1604701,
      "end": 1604753,
      "context_start": 1604701,
      "context_end": 1604840,
      "reason": "عنوان المصدر مستقل بالاسم والنسب، ولا يجعل النجم بين عمير وبن هاشم بداية خبر جديد."
    },
    {
      "start": 1604753,
      "end": 1604840,
      "context_start": 1604701,
      "context_end": 1605085,
      "reason": "استكمال النسب والسابقة والشهادة وصف افتتاحي متصل قبل إسناد البراء."
    },
    {
      "start": 1604840,
      "end": 1605085,
      "context_start": 1604753,
      "context_end": 1605489,
      "reason": "يجمع قدوم مصعب والسؤال عن رسول الله والجواب وقدوم ابن أم مكتوم؛ ثم أتانا تعبر الصفحة ولا ينقطع الحوار عند قال."
    },
    {
      "start": 1605085,
      "end": 1605489,
      "context_start": 1604840,
      "context_end": 1605768,
      "reason": "إسناد الأعمش عن خباب يتصل بخبر الهجرة والكفن وأمر تغطية الرأس والمقارنة بمن أينعت ثمرته؛ لا يفصل الأمر عن سياق الافتقار."
    },
    {
      "start": 1605489,
      "end": 1605768,
      "context_start": 1605085,
      "context_end": 1606283,
      "reason": "رواية إبراهيم عن بكاء عبد الرحمن نقل مستقل، مع إبقاء إسناد شعبة والسبب وخشية تعجيل الطيبات، ووصل ثوبًا واحدًا عبر الصفحة."
    },
    {
      "start": 1605768,
      "end": 1606283,
      "context_start": 1605489,
      "context_end": 1606708,
      "reason": "رواية ابن إسحاق عن القرظي والمبهم تحكي حال بردة مصعب ثم الحوار عن الرخاء والعبادة؛ لا أفصل الجواب عن السؤال ولا أحسم هوية المبهم."
    },
    {
      "start": 1606283,
      "end": 1606708,
      "context_start": 1605768,
      "context_end": 1606919,
      "reason": "طريق صالح بن كيسان عن سعد يقابل حال العيش قبل الهجرة وبعدها ثم شدة مصعب وحمله على العواتق؛ بقي وصف مصعب مع إسناد هذا الطريق."
    },
    {
      "start": 1606708,
      "end": 1606919,
      "context_start": 1606283,
      "context_end": 1607196,
      "reason": "انتقل المتكلم من وصف مصعب إلى تجربة شخصية في اقتيات الجلد بلفظ ولقد رأيتني؛ فصل داخلي مفهوم مع إبقاء سياق الرواية في الفقرة السابقة، لا خبر مخترع مستقل."
    },
    {
      "start": 1606919,
      "end": 1607196,
      "context_start": 1606708,
      "context_end": 1607196,
      "reason": "رواية ابن إسحاق في قتاله ومقتله ودعوى القاتل وإعطاء اللواء متصلة؛ لا تتحول دعوى قتلت محمدًا إلى خبر مقرر ولا يفصل الضمير عن مرجعه."
    }
  ]
}
