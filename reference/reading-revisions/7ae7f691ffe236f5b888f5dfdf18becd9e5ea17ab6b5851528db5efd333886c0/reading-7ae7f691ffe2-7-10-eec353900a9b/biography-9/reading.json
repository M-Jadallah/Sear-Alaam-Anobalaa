      "context_end": 1611754,
      "kind": "isnad",
      "reason": "وصف للخبر السابق بالإرسال."
    },
    {
      "start": 1612070,
      "end": 1612101,
      "context_start": 1612063,
      "context_end": 1612231,
      "kind": "isnad",
      "reason": "ينسب خبر القبر والحجر التالي إلى مراسيل عبيد الله بن أبي رافع."
    },
    {
      "start": 1612475,
      "end": 1612523,
      "context_start": 1612265,
      "context_end": 1612542,
      "kind": "isnad",
      "reason": "يحفظ نقد انقطاع الخبر وعدم ثبوته مع بيان زمان التحريم."
    },
    {
      "start": 1613665,
      "end": 1613674,
      "context_start": 1613455,
      "context_end": 1613681,
      "kind": "isnad",
      "reason": "نقد خبر الحوار السابق بالانقطاع."
    },
    {
      "start": 1614950,
      "end": 1614962,
      "context_start": 1614776,
      "context_end": 1614964,
      "kind": "hadith",
      "reason": "نسبة التصحيح إلى الترمذي في الخبر السابق."
    }
  ],
  "heading_labels": [
    {
      "at": 1611395,
      "label": "خَبَرُ وَضْعِ الْحَجَرِ عِنْدَ الْقَبْرِ"
    },
    {
      "at": 1611754,
      "label": "رَدُّ التَّبَتُّلِ"
    },
    {
      "at": 1612231,
      "label": "خَبَرُ الْخَمْرِ وَنَقْدُهُ"
    },
    {
      "at": 1612542,
      "label": "أَخْبَارُ الْوَفَاةِ وَالْبُكَاءِ"
    },
    {
      "at": 1613455,
      "label": "أَخْبَارُ التَّعَبُّدِ وَالْأُسْرَةِ"
    },
    {
      "at": 1614406,
      "label": "هِجْرَةُ آلِ مَظْعُونٍ"
    },
    {
      "at": 1614776,
      "label": "أَخْبَارُ الْوَفَاةِ وَالرُّؤْيَا"
    }
  ],
  "paragraph_notes": [
    {
      "start": 1611117,
      "end": 1611166,
      "context_start": 1611117,
      "context_end": 1611395,
      "reason": "عنوان المصدر يتضمن الاسم والنسب، وهو مستقل بنيويًا عن استكمال النسب في المتن."
    },
    {
      "start": 1611166,
      "end": 1611395,
      "context_start": 1611117,
      "context_end": 1611754,
      "reason": "جمع استكمال النسب والكنية والسبق وأولية الدفن وصف افتتاحي متصل قبل خبر الصخرة المسند."
    },
    {
      "start": 1611395,
      "end": 1611754,
      "context_start": 1611166,
      "context_end": 1611903,
      "reason": "رواية كثير عن المطلب خبر واحد في الصخرة عند القبر؛ حفظت الفعل والقول وتعليق هذا مرسل في الفقرة نفسها."
    },
    {
      "start": 1611754,
      "end": 1611903,
      "context_start": 1611395,
      "context_end": 1612063,
      "reason": "سند سعيد عن سعد يقدّم خبر رد التبتل وما علق به من الاختصاء؛ رواية مستقلة عن خبر القبر السابق."
    },
    {
      "start": 1611903,
      "end": 1612063,
      "context_start": 1611754,
      "context_end": 1612231,
      "reason": "قول أبي عمر يجمع وقت الإسلام والهجرتين والوفاة والعبادة مع خبر الهم بالاختصاء، وهو نقل تعريفي مستقل."
    },
    {
      "start": 1612063,
      "end": 1612231,
      "context_start": 1611903,
      "context_end": 1612542,
      "reason": "خبر عبيد الله بن أبي رافع احتفظ بتوصيف الطريق من مراسيله مع خبر قبر فرطنا؛ لا يفصل النقد عن المتن."
    },
    {
      "start": 1612231,
      "end": 1612542,
      "context_start": 1612063,
      "context_end": 1612973,
      "reason": "رواية ترك الخمر والقول المنسوب لعثمان يتلوهما رد المؤلف بالانقطاع وعدم الثبوت ووقوع التحريم بعد موته؛ حفظت الاستدراك المؤثر كله."
    },
    {
      "start": 1612542,
      "end": 1612973,
      "context_start": 1612231,
      "context_end": 1613455,
      "reason": "طريق سفيان وابن وهب يروي البكاء عند الوفاة وتنبيه مه ثم الاستغفار؛ المتكلم والحوار لا يتجزآن عند كل قال."
    },
    {
      "start": 1612973,
      "end": 1613455,
      "context_start": 1612542,
      "context_end": 1613681,
      "reason": "طريق حماد عن ابن عباس يحكي قول الزوجة والجواب وعدم الجزم ثم نهي النعيق؛ استمر عبر الصفحة ليحفظ التحذير والقيود."
    },
    {
      "start": 1613455,
      "end": 1613681,
      "context_start": 1612973,
      "context_end": 1613857,
      "reason": "طريق يعلى والإفريقي يروي حوار العورة واللباس ويتلوه هذا منقطع؛ النقد تابع للخبر نفسه."
    },
    {
      "start": 1613681,
      "end": 1613857,
      "context_start": 1613455,
      "context_end": 1614194,
      "reason": "خبر الزهري عن إرادة الاختصاء والسياحة وتعقيب النبي مستقل بإسناده عن حوار العورة السابق."
    },
    {
      "start": 1613857,
      "end": 1614194,
      "context_start": 1613681,
      "context_end": 1614406,
      "reason": "خبر أبي إسحاق وأبي بردة متصل بين وصف هيئة الزوجة وسؤال النساء ثم جواب النبي وعودة الزوجة؛ لا يقطع أما لك بي أسوة عند الصفحة."
    },
    {
      "start": 1614194,
      "end": 1614406,
      "context_start": 1613857,
      "context_end": 1614540,
      "reason": "طريق حماد ومعاوية وأبي قلابة خبر مستقل عن التعبد والرهبانية والحنيفية؛ أبقيت المتن والخطاب مع إسناده."
    },
    {
      "start": 1614406,
      "end": 1614540,
      "context_start": 1614194,
      "context_end": 1614628,
      "reason": "خبر عائشة بنت قدامة يعدد من نزلوا عند عبد الله بن سلمة حين الهجرة؛ العطف هنا أسماء في جملة رواية لا قائمة مصطنعة."
    },
    {
      "start": 1614540,
      "end": 1614628,
      "context_start": 1614406,
      "context_end": 1614748,
      "reason": "تعليق الواقدي يصف شمول خروج آل مظعون وإغلاق بيوتهم، وهو نقل مستقل عن تحديد منزل النزول قبله."
    },
    {
      "start": 1614628,
      "end": 1614748,
      "context_start": 1614540,
      "context_end": 1614776,
      "reason": "طريق عبيد الله بن عتبة يحدد موضع دار آل مظعون بالمدينة؛ لا يضم إلى نقل إغلاق بيوتهم بمكة لمجرد تشابه موضوع الهجرة."
    },
    {
      "start": 1614748,
      "end": 1614776,
      "context_start": 1614628,
      "context_end": 1614964,
      "reason": "جملة التأريخ للوفاة انتقلت من الهجرة إلى خبر الوفاة؛ أبقيتها فقرة قصيرة مستقلة دون فرض طول أدنى."
    },
    {
      "start": 1614776,
      "end": 1614964,
      "context_start": 1614748,
      "context_end": 1615093,
      "reason": "طريق الثوري وعائشة يروي تقبيل الميت والبكاء ويتلوه تصحيح الترمذي المنسوب إليه؛ أبقيت النقل وتقويمه معًا."
    },
    {
      "start": 1614964,
      "end": 1615093,
      "context_start": 1614776,
      "context_end": 1615656,
      "reason": "طريق مالك عن أبي النضر خبر مستقل في الجنازة وقول ذهبت ولم تلبس، لا تتمة لسند الثوري السابق."
    },
    {
      "start": 1615093,
      "end": 1615656,
      "context_start": 1614964,
      "context_end": 1615836,
      "reason": "رواية أم العلاء تحفظ شهادة الإكرام والجواب وقيد عدم الجزم ثم المنام وتفسيره في سياق واحد؛ جملة فأحزنني ذلك تعبر الصفحة دون فصل."
    },
    {
      "start": 1615656,
      "end": 1615836,
      "context_start": 1615093,
      "context_end": 1616080,
      "reason": "زيادة طريق حماد عن ابن عباس في إلحاق البنت بالسلف مستقلة بإسنادها ومرتبطة بسياق الوفاة السابق من غير دمج الروايتين."
    },
    {
      "start": 1615836,
      "end": 1616080,
      "context_start": 1615656,
      "context_end": 1616214,
      "reason": "طريق الواقدي عن عمر يروي تغير منزلته في نفسه عند وفيات لاحقة؛ حفظت نهاية قال فرجع عثمان لتبين المقصود بالخبر."
    },
    {
      "start": 1616080,
      "end": 1616214,
      "context_start": 1615836,
      "context_end": 1616214,
      "reason": "رواية عائشة بنت قدامة وصف للشبه والأدمة واللحية، مستقلة عن موقف عمر السابق ولا تستنتج حكمًا حديثيًا."
    }
  ]
}
