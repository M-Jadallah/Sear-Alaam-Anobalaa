      "reason": "استدراك على حصر أيوب حد البدري في الخمر، مع بقاء القولين متجاورين."
    }
  ],
  "heading_labels": [
    {
      "at": 1616399,
      "label": "الْهِجْرَةُ وَخَبَرُ الْحَدِّ وَالْعَزْلِ"
    },
    {
      "at": 1616716,
      "label": "أَوْلَادُهُ وَوَفَاتُهُ"
    }
  ],
  "paragraph_notes": [
    {
      "start": 1616214,
      "end": 1616258,
      "context_start": 1616214,
      "context_end": 1616399,
      "reason": "عنوان المصدر باسم صاحب الترجمة وكنيته مستقل بنيويًا."
    },
    {
      "start": 1616258,
      "end": 1616399,
      "context_start": 1616214,
      "context_end": 1616716,
      "reason": "الافتتاح يصف السابقة والولاية والقرابة والزواج في جملة تعريفية؛ لا أفرض موضوع الولاية على القرابات الملحقة."
    },
    {
      "start": 1616399,
      "end": 1616716,
      "context_start": 1616258,
      "context_end": 1616829,
      "reason": "خبر التأويل وشرب الخمر والحد يتلوه ادعاء الانفراد ثم بلى ومثال نعيمان؛ أبقيت التصويب مع الدعوى ومرجع الآية."
    },
    {
      "start": 1616716,
      "end": 1616829,
      "context_start": 1616399,
      "context_end": 1616972,
      "reason": "قول ابن سعد في الولد والهجرة والمشاهد نقل مستقل عن خبر الحد؛ لا يجعل تعداد الولد إسنادًا متقطعًا."
    },
    {
      "start": 1616829,
      "end": 1616972,
      "context_start": 1616716,
      "context_end": 1616972,
      "reason": "نقل عائشة عن تاريخ الوفاة والعمر والهيئة خبر مستقل عن نقل ابن سعد قبله."
    }
  ]
}
