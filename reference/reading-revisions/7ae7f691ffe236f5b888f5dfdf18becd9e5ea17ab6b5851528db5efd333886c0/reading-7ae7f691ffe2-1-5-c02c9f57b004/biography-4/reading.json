  "criticism": [
    {
      "start": 1539992,
      "end": 1540115,
      "context_start": 1538916,
      "context_end": 1540324,
      "kind": "hadith",
      "reason": "وصف الحديث بالغرابة وتخريجه نص المصدر، ولا يحول إلى تضعيف مستنتج."
    },
    {
      "start": 1540995,
      "end": 1541013,
      "context_start": 1540324,
      "context_end": 1541197,
      "kind": "hadith",
      "reason": "درجة حسن غريب منقولة حرفيًا، مع نقد النسائي التالي في السياق."
    },
    {
      "start": 1541137,
      "end": 1541196,
      "context_start": 1540324,
      "context_end": 1541197,
      "kind": "isnad",
      "reason": "تصويب النسائي لطريق الحديث منسوب إليه كما في الأصل."
    },
    {
      "start": 1542270,
      "end": 1542283,
      "context_start": 1541197,
      "context_end": 1542494,
      "kind": "hadith",
      "reason": "حكم الحسن كما ورد في المصدر، لا اعتماد علمي جديد."
    },
    {
      "start": 1542286,
      "end": 1542298,
      "context_start": 1541197,
      "context_end": 1542494,
      "kind": "hadith",
      "reason": "التصحيح منسوب صراحة إلى الترمذي؛ لا ينسب إلى التطبيق."
    },
    {
      "start": 1542496,
      "end": 1542843,
      "context_start": 1541197,
      "context_end": 1542844,
      "kind": "narrator",
      "reason": "تقويم التثبت والعدالة يحفظ استدلال النص كله بقبول عمر وطلبه الشاهد واستحلاف علي وتصديقه أبا بكر، مع والله أعلم، دون تقرير أحكام جديدة."
    },
    {
      "start": 1543018,
      "end": 1543117,
      "context_start": 1542900,
      "context_end": 1543209,
      "kind": "report",
      "reason": "يذكر المصدر اختلاف نقل نسبه وإسقاط اسم عبد في بعض طرقه؛ لا يصحح التطبيق النسب ولا يختار إحدى الروايات."
    },
    {
      "start": 1544774,
      "end": 1544782,
      "context_start": 1544097,
      "context_end": 1545420,
      "kind": "report",
      "reason": "علامة التحفظ كذا هذا في خبر المؤاخاة تحفظ كما هي؛ لا يصحح التطبيق الاسم في المتن."
    },
    {
      "start": 1545152,
      "end": 1545227,
      "context_start": 1544417,
      "context_end": 1545420,
      "kind": "hadith",
      "reason": "حكم حديث منكر يتضمن عزوه لأحمد في العبارة السابقة؛ لا تظهر البشارة منزوعة النقد."
    },
    {
      "start": 1546072,
      "end": 1546083,
      "context_start": 1545420,
      "context_end": 1546424,
      "kind": "isnad",
      "reason": "تقويم إسناد الخبر الثاني بالوهاء موجود حرفيًا، مع سياق الروايتين."
    },
    {
      "start": 1546086,
      "end": 1546243,
      "context_start": 1544417,
      "context_end": 1546424,
      "kind": "narrator",
      "reason": "يجتمع اللين مع أقوال أبي حاتم وابن معين وابن عدي وتحفظ النسائي، فلا ينتقى رأي واحد ويحذف خلافه."
    },
    {
      "start": 1546246,
      "end": 1546423,
      "context_start": 1545420,
      "context_end": 1546424,
      "kind": "report",
      "reason": "التوجيه الاحتمالي للاحتساب والاستعارة يظل بصيغة الشرط ولا يتحول إلى إثبات صحة الرواية."
    },
    {
      "start": 1547689,
      "end": 1547721,
      "context_start": 1547485,
      "context_end": 1547722,
      "kind": "narrator",
      "reason": "التدليس وعدم السماع للحسن في الطريق المذكور، لا لعبد الرحمن بن عوف."
    },
    {
      "start": 1547879,
      "end": 1547987,
      "context_start": 1547722,
      "context_end": 1547988,
      "kind": "narrator",
      "reason": "ضعف عثمان في الإسناد مع الاستدراك بذكر طريق آخر محفوظ كاملًا."
    },
    {
      "start": 1549004,
      "end": 1549213,
      "context_start": 1548857,
      "context_end": 1549214,
      "kind": "report",
      "reason": "يشمل الإسناد الحسن وقيد المنام وتأويله والتعليق المتصل؛ يمنع إيهام أن الحديث خبر يقظة محقق."
    },
    {
      "start": 1550521,
      "end": 1550609,
      "context_start": 1550156,
      "context_end": 1550610,
      "kind": "isnad",
      "reason": "بيان تفرد الطريق ووجود رواية عن الحسن مرسلة منقول دون إسقاط أحد القيدين."
    },
    {
      "start": 1551255,
      "end": 1551269,
      "context_start": 1550610,
      "context_end": 1551324,
      "kind": "hadith",
      "reason": "التصحيح منسوب إلى الترمذي صراحة مع سياق تعدد الطرق."
    },
    {
      "start": 1553635,
      "end": 1553658,
      "context_start": 1553320,
      "context_end": 1553659,
      "kind": "narrator",
      "reason": "التضعيف يخص أبا المعلى في سند الخبر، لا صاحب الترجمة."
    }
  ],
