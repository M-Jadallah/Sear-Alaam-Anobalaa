    {
      "start": 1556307,
      "end": 1556375,
      "context_start": 1556189,
      "context_end": 1556532,
      "reason": "وصية الخيل طريق مستقل يذكر اختلاف الإسناد."
    },
    {
      "start": 1556375,
      "end": 1556532,
      "context_start": 1556307,
      "context_end": 1556684,
      "reason": "كلمة علي واللفظ المفسر بالكدر تحفظ مع تفسير الرنق."
    },
    {
      "start": 1556532,
      "end": 1556684,
      "context_start": 1556375,
      "context_end": 1556796,
      "reason": "ندبة سعد عند الجنازة ومتابعاتها مع الإسناد."
    },
    {
      "start": 1556684,
      "end": 1556796,
      "context_start": 1556532,
      "context_end": 1556915,
      "reason": "قسمة النساء بعد موته بإسناد أنس؛ لا تحول أعداد المال إلى حواش."
    },
    {
      "start": 1556796,
      "end": 1556915,
      "context_start": 1556684,
      "context_end": 1556980,
      "reason": "رواية ابن سيرين في اقتسام الثمن والمتابعة تحفظ اختلاف الرقم."
    },
    {
      "start": 1556915,
      "end": 1556980,
      "context_start": 1556796,
      "context_end": 1557442,
      "reason": "إحالة تاريخ دمشق وصف للمصدر لا متن جديد."
    },
    {
      "start": 1556980,
      "end": 1557442,
      "context_start": 1556915,
      "context_end": 1557546,
      "reason": "الهجرة والمؤاخاة والتجارة والزواج والوليمة خبر متصل لا يفصل الدعاء عن الجواب."
    },
    {
      "start": 1557442,
      "end": 1557546,
      "context_start": 1556980,
      "context_end": 1557597,
      "reason": "أقوال التأريخ والدفن محفوظة بنسبة أصحابها."
    },
    {
      "start": 1557546,
      "end": 1557597,
      "context_start": 1557442,
      "context_end": 1557730,
      "reason": "قول العمر خمس وسبعون سنة منقول مستقل."
    },
    {
      "start": 1557597,
      "end": 1557730,
      "context_start": 1557546,
      "context_end": 1557810,
      "reason": "تعريف المجدود في التجارة وعدد المال والزراعة في سياق واحد."
    },
    {
      "start": 1557730,
      "end": 1557810,
      "context_start": 1557597,
      "context_end": 1557904,
      "reason": "مقارنة الشاكر والفقير والزاهد مع إبقاء الرسم الملتبس وآوي دون إصلاح."
    },
    {
      "start": 1557810,
      "end": 1557904,
      "context_start": 1557730,
      "context_end": 1557904,
      "reason": "بلاغ آخر بإسناد الجافي وأترقان محفوظ دون حسم الاسمين أو تصحيحهما."
    }
