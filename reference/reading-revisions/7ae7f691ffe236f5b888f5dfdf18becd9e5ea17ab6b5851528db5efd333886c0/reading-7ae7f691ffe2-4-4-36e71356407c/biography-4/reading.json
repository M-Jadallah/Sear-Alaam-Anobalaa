  "criticism": [
    {
      "start": 1539992,
      "end": 1540115,
      "context_start": 1538916,
      "context_end": 1540324,
      "kind": "hadith",
      "reason": "وصف الحديث بالغرابة وتخريجه نص المصدر، ولا يحول إلى تضعيف مستنتج."
    },
    {
      "start": 1540995,
      "end": 1541013,
      "context_start": 1540324,
      "context_end": 1541197,
      "kind": "hadith",
      "reason": "درجة حسن غريب منقولة حرفيًا، مع نقد النسائي التالي في السياق."
    },
    {
      "start": 1541137,
      "end": 1541196,
      "context_start": 1540324,
      "context_end": 1541197,
      "kind": "isnad",
      "reason": "تصويب النسائي لطريق الحديث منسوب إليه كما في الأصل."
    },
    {
      "start": 1542270,
      "end": 1542283,
      "context_start": 1541197,
      "context_end": 1542494,
      "kind": "hadith",
      "reason": "حكم الحسن كما ورد في المصدر، لا اعتماد علمي جديد."
    },
    {
      "start": 1542286,
      "end": 1542298,
      "context_start": 1541197,
      "context_end": 1542494,
      "kind": "hadith",
      "reason": "التصحيح منسوب صراحة إلى الترمذي؛ لا ينسب إلى التطبيق."
    },
    {
      "start": 1542496,
      "end": 1542843,
      "context_start": 1541197,
      "context_end": 1542844,
      "kind": "narrator",
      "reason": "تقويم التثبت والعدالة يحفظ استدلال النص كله بقبول عمر وطلبه الشاهد واستحلاف علي وتصديقه أبا بكر، مع والله أعلم، دون تقرير أحكام جديدة."
    },
    {
      "start": 1543018,
      "end": 1543117,
      "context_start": 1542900,
      "context_end": 1543209,
      "kind": "report",
      "reason": "يذكر المصدر اختلاف نقل نسبه وإسقاط اسم عبد في بعض طرقه؛ لا يصحح التطبيق النسب ولا يختار إحدى الروايات."
    },
    {
      "start": 1544774,
      "end": 1544782,
      "context_start": 1544097,
      "context_end": 1545420,
      "kind": "report",
      "reason": "علامة التحفظ كذا هذا في خبر المؤاخاة تحفظ كما هي؛ لا يصحح التطبيق الاسم في المتن."
    },
    {
      "start": 1545152,
      "end": 1545227,
      "context_start": 1544417,
      "context_end": 1545420,
      "kind": "hadith",
      "reason": "حكم حديث منكر يتضمن عزوه لأحمد في العبارة السابقة؛ لا تظهر البشارة منزوعة النقد."
    },
    {
      "start": 1546072,
      "end": 1546083,
      "context_start": 1545420,
      "context_end": 1546424,
      "kind": "isnad",
      "reason": "تقويم إسناد الخبر الثاني بالوهاء موجود حرفيًا، مع سياق الروايتين."
    },
    {
      "start": 1546086,
      "end": 1546243,
      "context_start": 1544417,
      "context_end": 1546424,
      "kind": "narrator",
      "reason": "يجتمع اللين مع أقوال أبي حاتم وابن معين وابن عدي وتحفظ النسائي، فلا ينتقى رأي واحد ويحذف خلافه."
    },
    {
      "start": 1546246,
      "end": 1546423,
      "context_start": 1545420,
      "context_end": 1546424,
      "kind": "report",
      "reason": "التوجيه الاحتمالي للاحتساب والاستعارة يظل بصيغة الشرط ولا يتحول إلى إثبات صحة الرواية."
    },
    {
      "start": 1547689,
      "end": 1547721,
      "context_start": 1547485,
      "context_end": 1547722,
      "kind": "narrator",
      "reason": "التدليس وعدم السماع للحسن في الطريق المذكور، لا لعبد الرحمن بن عوف."
    },
    {
      "start": 1547879,
      "end": 1547987,
      "context_start": 1547722,
      "context_end": 1547988,
      "kind": "narrator",
      "reason": "ضعف عثمان في الإسناد مع الاستدراك بذكر طريق آخر محفوظ كاملًا."
    },
    {
      "start": 1549004,
      "end": 1549213,
      "context_start": 1548857,
      "context_end": 1549214,
      "kind": "report",
      "reason": "يشمل الإسناد الحسن وقيد المنام وتأويله والتعليق المتصل؛ يمنع إيهام أن الحديث خبر يقظة محقق."
    },
    {
      "start": 1550521,
      "end": 1550609,
      "context_start": 1550156,
      "context_end": 1550610,
      "kind": "isnad",
      "reason": "بيان تفرد الطريق ووجود رواية عن الحسن مرسلة منقول دون إسقاط أحد القيدين."
    },
    {
      "start": 1551255,
      "end": 1551269,
      "context_start": 1550610,
      "context_end": 1551324,
      "kind": "hadith",
      "reason": "التصحيح منسوب إلى الترمذي صراحة مع سياق تعدد الطرق."
    },
    {
      "start": 1553635,
      "end": 1553658,
      "context_start": 1553320,
      "context_end": 1553659,
      "kind": "narrator",
      "reason": "التضعيف يخص أبا المعلى في سند الخبر، لا صاحب الترجمة."
    }
  ],
  "heading_overrides": [
    {
      "from_at": 1544464,
      "at": 1544417
    }
  ],
  "paragraph_notes": [
    {
      "start": 1538102,
      "end": 1538154,
      "context_start": 1538102,
      "context_end": 1538222,
      "reason": "عنوان المصدر مستقل بالاسم والنسب والرمز؛ لا يدمج في سند الروايات."
    },
    {
      "start": 1538154,
      "end": 1538222,
      "context_start": 1538102,
      "context_end": 1538346,
      "reason": "استكمال نسب عبد بن الحارث وكنية أبي محمد بطاقة افتتاحية."
    },
    {
      "start": 1538222,
      "end": 1538346,
      "context_start": 1538154,
      "context_end": 1538363,
      "reason": "صفة العشرة والشورى والسبق والإسلام جملة تعريفية متصلة."
    },
    {
      "start": 1538346,
      "end": 1538363,
      "context_start": 1538222,
      "context_end": 1538501,
      "reason": "عدد أحاديثه إشعار تعريفي مستقل قبل سرد الرواة."
    },
    {
      "start": 1538363,
      "end": 1538501,
      "context_start": 1538346,
      "context_end": 1538623,
      "reason": "تعداد الرواة والأبناء باق في جملة واحدة، لا يحول السند إلى قائمة."
    },
    {
      "start": 1538501,
      "end": 1538623,
      "context_start": 1538363,
      "context_end": 1538729,
      "reason": "عدد الصحيحين ومسند بقي مع وصل خمسة أحاديث عبر الصفحة."
    },
    {
      "start": 1538623,
      "end": 1538729,
      "context_start": 1538501,
      "context_end": 1538838,
      "reason": "الاسم الجاهلي والقول البديل والتسمية متصلان دون ترجيح."
    },
    {
      "start": 1538729,
      "end": 1538838,
      "context_start": 1538623,
      "context_end": 1538916,
      "reason": "قائمة الصحابة الذين حدثوا عنه استكمال للرواة بوحدة مستقلة."
    },
    {
      "start": 1538838,
      "end": 1538916,
      "context_start": 1538729,
      "context_end": 1540116,
      "reason": "خبر الجابية وسرغ في سياق واحد قبل الإسناد الطويل."
    },
    {
      "start": 1538916,
      "end": 1540116,
      "context_start": 1538838,
      "context_end": 1540156,
      "reason": "سند الكتاب في المجوس وأوامره وشهادة الجزية والتخريج والتقويم متصلة؛ لا تفصل السواحر أو الزمزمة عن سياق النقل."
    },
    {
      "start": 1540116,
      "end": 1540156,
      "context_start": 1538916,
      "context_end": 1540324,
      "reason": "طريق حجاج المختصر متابعة إسنادية مستقلة."
    },
    {
      "start": 1540156,
      "end": 1540324,
      "context_start": 1540116,
      "context_end": 1541197,
      "reason": "طريق آخر لأخذ الجزية يحفظ راويا مبهمًا ولا يحسم هويته."
    },
    {
      "start": 1540324,
      "end": 1541197,
      "context_start": 1540156,
      "context_end": 1542388,
      "reason": "أسانيد رمضان والمتن وتقويمه وتصويب النسائي متصلة دون إظهار درجة مبتورة."
    },
    {
      "start": 1541197,
      "end": 1542388,
      "context_start": 1540324,
      "context_end": 1542494,
      "reason": "سند السهو وحوار عمر وعبد الرحمن والمتن والتصحيح تتصل عبر الصفحات."
    },
    {
      "start": 1542388,
      "end": 1542494,
      "context_start": 1541197,
      "context_end": 1542844,
      "reason": "زيادة طريق ابن عساكر تحفظ لفظ العدل الرضا وصلته بالحوار."
    },
    {
      "start": 1542494,
      "end": 1542844,
      "context_start": 1542388,
      "context_end": 1542900,
      "reason": "تعقيب عدالة الصحابة يجمع التفاضل والتثبت والاستحلاف، دون نزع السياق."
    },
    {
      "start": 1542844,
      "end": 1542900,
      "context_start": 1542494,
      "context_end": 1543118,
      "reason": "خبر الميلاد المنسوب للمدائني مستقل."
    },
    {
      "start": 1542900,
      "end": 1543118,
      "context_start": 1542844,
      "context_end": 1543209,
      "reason": "نسب الزبير واختلاف إسقاط عبد محفوظ دون تصويب شجرة الأصل."
    },
    {
      "start": 1543118,
      "end": 1543209,
      "context_start": 1542900,
      "context_end": 1543285,
      "reason": "نقل الشاشي والكلاباذي وجه آخر للنسب، لا يحسم الاتحاد تلقائيًا."
    },
    {
      "start": 1543209,
      "end": 1543285,
      "context_start": 1543118,
      "context_end": 1543373,
      "reason": "قول الجماعة في اسم الأم يحفظ معه نسبة القول."
    },
    {
      "start": 1543285,
      "end": 1543373,
      "context_start": 1543209,
      "context_end": 1543525,
      "reason": "قول الحاكم والاسم الآخر للأم متجاوران دون ترجيح."
    },
    {
      "start": 1543373,
      "end": 1543525,
      "context_start": 1543285,
      "context_end": 1543790,
      "reason": "خبر الاسم الجاهلي وتغييره مع إسناده ووصل عبد الرحمن."
    },
    {
      "start": 1543525,
      "end": 1543790,
      "context_start": 1543373,
      "context_end": 1543938,
      "reason": "وصف سهلة للهيئة مع السند العابر للصفحة."
    },
    {
      "start": 1543790,
      "end": 1543938,
      "context_start": 1543525,
      "context_end": 1544097,
      "reason": "خبر ابن إسحاق عن إصابته وعرجه وصف مستقل بإسناده."
    },
    {
      "start": 1543938,
      "end": 1544097,
      "context_start": 1543790,
      "context_end": 1544308,
      "reason": "وصف الواقدي الطويل في الوجه والبشرة والجنأ متصل."
    },
    {
      "start": 1544097,
      "end": 1544308,
      "context_start": 1543938,
      "context_end": 1544417,
      "reason": "حوار عثمان في الطريق والهجرتين مع الإسناد."
    },
    {
      "start": 1544308,
      "end": 1544417,
      "context_start": 1544097,
      "context_end": 1545228,
      "reason": "ذكر متابعة العقدي مستقل، قبل بدء طريق عال جديد."
    },
    {
      "start": 1544417,
      "end": 1545228,
      "context_start": 1544308,
      "context_end": 1545420,
      "reason": "إسناد أبي الحسين وخبر القافلة والتصدق ونقد أحمد متصل؛ لا يقع عنوان مضاف وسط الإسناد بعد عن المسور."
    },
    {
      "start": 1545228,
      "end": 1545420,
      "context_start": 1544417,
      "context_end": 1546084,
      "reason": "لفظ أحمد الآخر والتصدق بالأحمال متابعة متصلة."
    },
    {
      "start": 1545420,
      "end": 1546084,
      "context_start": 1545228,
      "context_end": 1546244,
      "reason": "طريق أبي أمامة في الجنة والمحاسبة وإسناده واه لا يفصل نقده."
    },
    {
      "start": 1546084,
      "end": 1546244,
      "context_start": 1545420,
      "context_end": 1546424,
      "reason": "تقييد الطريق السابق بعمارة وأقوال النقاد متعددة تحفظ دون اختزال."
    },
    {
      "start": 1546244,
      "end": 1546424,
      "context_start": 1546084,
      "context_end": 1546693,
      "reason": "فرض الاستعارة الشرطي يحفظ فلو ولا يحول إلى خبر جازم."
    },
    {
      "start": 1546424,
      "end": 1546693,
      "context_start": 1546244,
      "context_end": 1547045,
      "reason": "المناقب وشهود بدر وبيعة الشجرة والصلاة خلفه وصف متصل."
    },
    {
      "start": 1546693,
      "end": 1547045,
      "context_start": 1546424,
      "context_end": 1547123,
      "reason": "رواية المغيرة في الصلاة والمسح مع السؤال والجواب."
    },
    {
      "start": 1547045,
      "end": 1547123,
      "context_start": 1546693,
      "context_end": 1547346,
      "reason": "متابعة حميد وبكر وحمزة طريق مستقل موجز."
    },
    {
      "start": 1547123,
      "end": 1547346,
      "context_start": 1547045,
      "context_end": 1547485,
      "reason": "خبر إبراهيم في إمامة عبد الرحمن مع بقاء الإيماء والصلاة في سياقه."
    },
    {
      "start": 1547346,
      "end": 1547485,
      "context_start": 1547123,
      "context_end": 1547542,
      "reason": "طريق أحمد عن رشدين متابعة مع إسنادها."
    },
    {
      "start": 1547485,
      "end": 1547542,
      "context_start": 1547346,
      "context_end": 1547641,
      "reason": "متابعة هشام وقتادة والحسن نص مستقل."
    },
    {
      "start": 1547542,
      "end": 1547641,
      "context_start": 1547485,
      "context_end": 1547722,
      "reason": "طريق زرارة في الصلاة خلف عبد الرحمن مستقل."
    },
    {
      "start": 1547641,
      "end": 1547722,
      "context_start": 1547542,
      "context_end": 1547988,
      "reason": "طريق خليد يليه تقييد تدليس الحسن وعدم سماعه؛ لا يفصل النقد."
    },
    {
      "start": 1547722,
      "end": 1547988,
      "context_start": 1547641,
      "context_end": 1548175,
      "reason": "خبر اللواء ونقد عثمان والاستدراك بطريق آخر محفوظان معًا."
    },
    {
      "start": 1547988,
      "end": 1548175,
      "context_start": 1547722,
      "context_end": 1548469,
      "reason": "رواية الصدقة والآية تتضمن اتهام المنافقين منسوبا إليهم لا وصفا مقررا."
    },
    {
      "start": 1548175,
      "end": 1548469,
      "context_start": 1547988,
      "context_end": 1548857,
      "reason": "قول الزهري في الصدقات ومصدره الزهد متصل دون اختلاق قصة مستقلة."
    },
    {
      "start": 1548469,
      "end": 1548857,
      "context_start": 1548175,
      "context_end": 1549214,
      "reason": "طريق خالد بن يزيد وقول الاقتراض محفوظ بإسناده."
    },
    {
      "start": 1548857,
      "end": 1549214,
      "context_start": 1548469,
      "context_end": 1549720,
      "reason": "رؤيا دخول الجنة حبوًا وتعقيب إسناده حسن مع قيد المنام ووصل أطلقت له عبر الصفحة في فقرة واحدة."
    },
    {
      "start": 1549214,
      "end": 1549720,
      "context_start": 1548857,
      "context_end": 1549799,
      "reason": "حوار أم سلمة والخوف من المال ثم سؤال عمر وجوابها متصل بإسناده."
    },
    {
      "start": 1549720,
      "end": 1549799,
      "context_start": 1549214,
      "context_end": 1550042,
      "reason": "متابعة أبي معاوية عن شقيق طريق مستقل."
    },
    {
      "start": 1549799,
      "end": 1550042,
      "context_start": 1549720,
      "context_end": 1550156,
      "reason": "خبر خالد وعبد الرحمن وحديث دعوا لي أصحابي مع إسناد زائدة."
    },
    {
      "start": 1550042,
      "end": 1550156,
      "context_start": 1549799,
      "context_end": 1550610,
      "reason": "اختلاف طريق الأعمش والشاهد الآخر يحفظ دون دمج الأسانيد."
    },
    {
      "start": 1550156,
      "end": 1550610,
      "context_start": 1550042,
      "context_end": 1551041,
      "reason": "شكوى خالد والجوابان والاستدراك بجرير ومرسله متصل."
    },
    {
      "start": 1550610,
      "end": 1551041,
      "context_start": 1550156,
      "context_end": 1551105,
      "reason": "خبر حراء بأسماء الحضور والمتابعات والتخريج يحتفظ بسياق الشهادة."
    },
    {
      "start": 1551041,
      "end": 1551105,
      "context_start": 1550610,
      "context_end": 1551324,
      "reason": "متابعة سفيان عن منصور طريق مستقل."
    },
    {
      "start": 1551105,
      "end": 1551324,
      "context_start": 1551041,
      "context_end": 1551632,
      "reason": "قول أبي داود وزيادة ابن حيان والتصحيح محفوظة في وحدة مقارنة طرق."
    },
    {
      "start": 1551324,
      "end": 1551632,
      "context_start": 1551105,
      "context_end": 1551715,
      "reason": "سؤال عمر لأم كلثوم وخبر الزواج مع السند والجواب."
    },
    {
      "start": 1551632,
      "end": 1551715,
      "context_start": 1551324,
      "context_end": 1551811,
      "reason": "طريق ابن المديني متابعة لسؤال أم كلثوم."
    },
    {
      "start": 1551715,
      "end": 1551811,
      "context_start": 1551632,
      "context_end": 1552114,
      "reason": "ذكر الوجهين عن أم كلثوم متابعة مستقلة."
    },
    {
      "start": 1551811,
      "end": 1552114,
      "context_start": 1551715,
      "context_end": 1552295,
      "reason": "عدم إعطائه وخوفه ثم جواب التوكيل إلى الإيمان متصل."
    },
    {
      "start": 1552114,
      "end": 1552295,
      "context_start": 1551811,
      "context_end": 1552715,
      "reason": "حديث خياركم والوصية للنساء مع الإسناد والقيمة."
    },
    {
      "start": 1552295,
      "end": 1552715,
      "context_start": 1552114,
      "context_end": 1552876,
      "reason": "قسمة المال ودعاء عائشة والتخريج خبر واحد مع وصل بني زهرة عبر الصفحة."
    },
    {
      "start": 1552715,
      "end": 1552876,
      "context_start": 1552295,
      "context_end": 1553120,
      "reason": "طريق الوازع في حفظ أزواج النبي مستقل."
    },
    {
      "start": 1552876,
      "end": 1553120,
      "context_start": 1552715,
      "context_end": 1553320,
      "reason": "تعقيب الشورى واختيار عثمان وحفظ شرط لو كان محابيا دون جعله تقرير محاباة."
    },
    {
      "start": 1553120,
      "end": 1553320,
      "context_start": 1552876,
      "context_end": 1553659,
      "reason": "ذكر الفتوى في العهود الثلاثة مع إسناده."
    },
    {
      "start": 1553320,
      "end": 1553659,
      "context_start": 1553120,
      "context_end": 1553736,
      "reason": "خبر التنحي والأمانة يليه نقد أبي المعلى بالضعف؛ لا يخفي الترتيب نقد الرواية."
    },
    {
      "start": 1553659,
      "end": 1553736,
      "context_start": 1553320,
      "context_end": 1554016,
      "reason": "ذكر حجه بالمسلمين تأريخ مستقل منسوب للشعبي."
    },
    {
      "start": 1553736,
      "end": 1554016,
      "context_start": 1553659,
      "context_end": 1554434,
      "reason": "رسالة سعد ورد عبد الرحمن في الولاية والمتابعة خبر متصل."
    },
    {
      "start": 1554016,
      "end": 1554434,
      "context_start": 1553736,
      "context_end": 1554874,
      "reason": "خبر المسور وعمرو والجواب بخشية الولاية مستمر عبر الصفحة."
    },
    {
      "start": 1554434,
      "end": 1554874,
      "context_start": 1554016,
      "context_end": 1555032,
      "reason": "خبر استخلاف عثمان ودعاء عبد الرحمن والوفاة مع إسناده دون القطع بسبب الأجوبة."
    },
    {
      "start": 1554874,
      "end": 1555032,
      "context_start": 1554434,
      "context_end": 1555049,
      "reason": "صدر خبر أهل المدينة يمهد لتعداد الأقسام؛ يبقى متصلا بعناصر القائمة بنطاقاتها السابقة."
    },
    {
      "start": 1555032,
      "end": 1555049,
      "context_start": 1554874,
      "context_end": 1555068,
      "reason": "عنصر الإقراض كما في القائمة المؤلفة سابقا؛ ليس خبرا مستقلا عن صدرها."
    },
    {
      "start": 1555049,
      "end": 1555068,
      "context_start": 1555032,
      "context_end": 1555078,
      "reason": "عنصر قضاء الديون يحفظ الواو واستمرار خبر العيال."
    },
    {
      "start": 1555068,
      "end": 1555078,
      "context_start": 1555049,
      "context_end": 1555079,
      "reason": "عنصر الصلة يحفظ ترتيبه ولفظه كما في الأصل."
    },
    {
      "start": 1555078,
      "end": 1555079,
      "context_start": 1555068,
      "context_end": 1555319,
      "reason": "السطر التقني اللاحق للتعداد محسوب دون إنشاء فقرة فارغة."
    },
    {
      "start": 1555079,
      "end": 1555319,
      "context_start": 1555078,
      "context_end": 1555409,
      "reason": "حوار عيادة طلحة والإقرار بالتقصير متصل عبر الصفحة."
    },
    {
      "start": 1555319,
      "end": 1555409,
      "context_start": 1555079,
      "context_end": 1555984,
      "reason": "خبر عدم تميزه عن عبيده بإسناده مستقل."
    },
    {
      "start": 1555409,
      "end": 1555984,
      "context_start": 1555319,
      "context_end": 1556025,
      "reason": "خبر الغشية والرجلين والجواب والعمر بعدها متصل؛ لا يحول المنام المنقول إلى تحقق خارجي."
    },
    {
      "start": 1555984,
      "end": 1556025,
      "context_start": 1555409,
      "context_end": 1556059,
      "reason": "متابعة الزبيدي للغشية نقل إسنادي مستقل."
    },
    {
      "start": 1556025,
      "end": 1556059,
      "context_start": 1555984,
      "context_end": 1556189,
      "reason": "متابعة سعد بن إبراهيم للغشية نقل إسنادي مستقل."
    },
    {
      "start": 1556059,
      "end": 1556189,
      "context_start": 1556025,
      "context_end": 1556307,
      "reason": "وصية الخمسين ألفا وتوزيع الألف في سبيل الله خبر مستقل."
    },
    {
      "start": 1556189,
      "end": 1556307,
      "context_start": 1556059,
      "context_end": 1556375,
      "reason": "وصية البدريين وقبول عثمان لها خبر بإسناد الزهري."
