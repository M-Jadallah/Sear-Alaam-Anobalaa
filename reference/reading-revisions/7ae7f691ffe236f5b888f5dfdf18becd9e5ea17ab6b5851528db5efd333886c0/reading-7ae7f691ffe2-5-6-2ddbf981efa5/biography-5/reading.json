  "criticism": [
    {
      "start": 1560947,
      "end": 1560953,
      "context_start": 1560799,
      "context_end": 1561122,
      "kind": "isnad",
      "reason": "الانقطاع وصف للخبر السابق المحدد، ولا ينسحب على الأخبار الأخرى في رخص السفر."
    },
    {
      "start": 1562828,
      "end": 1562838,
      "context_start": 1562433,
      "context_end": 1562866,
      "kind": "hadith",
      "reason": "اتفاق الشيخين وصف مذكور لهذا الحديث، بخلاف تعريف أبي عون في أول الترجمة."
    },
    {
      "start": 1563537,
      "end": 1563550,
      "context_start": 1563322,
      "context_end": 1563551,
      "kind": "isnad",
      "reason": "الانقطاع متصل بخبر السهم المتكرر نفسه، ولا يحذف عند قراءة الموقف."
    },
    {
      "start": 1564343,
      "end": 1564445,
      "context_start": 1564214,
      "context_end": 1564446,
      "kind": "isnad",
      "reason": "يحفظ تفرد ابن عيينة مع الطريق الآخر الموصوف بأنه أصح، فلا ينتقى الترجيح منفردًا."
    },
    {
      "start": 1571619,
      "end": 1571635,
      "context_start": 1571569,
      "context_end": 1571770,
      "kind": "narrator",
      "reason": "توثيق منقول عن ابن شهاب لراو مبهم؛ لا يعيّن التطبيق هويته ولا يستنتج منه تصحيح الحديث."
    },
    {
      "start": 1575259,
      "end": 1575274,
      "context_start": 1574545,
      "context_end": 1575275,
      "kind": "hadith",
      "reason": "متفق عليه تقويم منقول في سياق الخبر المحدد عن الشكوى والتحقق، لا اعتماد للاتهامات الواردة في الحوار."
    },
    {
      "start": 1578632,
      "end": 1578649,
      "context_start": 1578456,
      "context_end": 1578650,
      "kind": "narrator",
      "reason": "التضعيف بالترك يخص مينا راوِي الخبر الخارق، ولا يحول الخبر إلى كرامة محققة."
    },
    {
      "start": 1582584,
      "end": 1582623,
      "context_start": 1581683,
      "context_end": 1582624,
      "kind": "hadith",
      "reason": "اتفاق منقول من طرق الزهري لحديث الوصية، ولا يوسع إلى جميع ما في الترجمة."
    },
    {
      "start": 1584381,
      "end": 1584461,
      "context_start": 1584188,
      "context_end": 1584462,
      "kind": "report",
      "reason": "ترجيح تاريخ الوفاة يظل مرتبطًا بتواريخ الأقوال السابقة؛ لا تغير سنة في النص أو بيانات الأعلام."
    }
  ],
  "paragraph_notes": [
    {
      "start": 1557904,
      "end": 1557956,
      "context_start": 1557904,
      "context_end": 1558050,
      "reason": "عنوان المصدر بالنسب مستقل عن متن الترجمة."
    },
    {
      "start": 1557956,
      "end": 1558184,
      "context_start": 1557904,
      "context_end": 1558305,
      "reason": "استكمال نسب أبي وقاص يتصل بالعنوان ويبدأ بطاقة التعريف. الكنية والنسبة وصف افتتاحي لصاحب الترجمة، لا خبر بإسناد جديد. السابقة والمشاهد والشورى تتم بطاقة التعريف قبل إحصاء الرواية."
    },
    {
      "start": 1558184,
      "end": 1558305,
      "context_start": 1558093,
      "context_end": 1558692,
      "reason": "إحصاء أحاديثه ومرويات الصحيحين وحدة معلومات مستقلة عن السابقة."
    },
    {
      "start": 1558305,
      "end": 1558692,
      "context_start": 1558184,
      "context_end": 1559184,
      "reason": "أسماء الرواة عنه جملة تعداد متصلة؛ لا تُحوّل الأسانيد التالية إلى تعداد."
    },
    {
      "start": 1558692,
      "end": 1559184,
      "context_start": 1558305,
      "context_end": 1559235,
      "reason": "سند أبي يعلى يتصل بشكوى الصلاة وجواب سعد وجواب عمر عبر الصفحة؛ لا فصل للحوار."
    },
    {
      "start": 1559184,
      "end": 1559235,
      "context_start": 1558692,
      "context_end": 1560407,
      "reason": "تعريف أبي عون وتوثيقه تعقيب على رجال السند السابق؛ يبقى بجواره."
    },
    {
      "start": 1559235,
      "end": 1560407,
      "context_start": 1559184,
      "context_end": 1560799,
      "reason": "خبر عدم رد عثمان السلام يتصل بسبب شروده وحديث دعاء ذي النون والتخريج؛ الحوار كله سياق واحد."
    },
    {
      "start": 1560407,
      "end": 1560799,
      "context_start": 1559235,
      "context_end": 1560954,
      "reason": "خبر الخروج إلى الشام والصيام والفطر حوار فقهي واحد بإسناد مستقل عن الدعاء."
    },
    {
      "start": 1560799,
      "end": 1560954,
      "context_start": 1560407,
      "context_end": 1561122,
      "reason": "خبر إقامة سعد عند معاوية وقصره وفطره يُحفظ مع نقد الانقطاع اللاحق."
    },
    {
      "start": 1560954,
      "end": 1561122,
      "context_start": 1560799,
      "context_end": 1561174,
      "reason": "طريق حبيب يروي الصلاة ركعتين وسبب الجواب؛ الرواية مستقلة عن الطريق السابق."
    },
    {
      "start": 1561122,
      "end": 1561174,
      "context_start": 1560954,
      "context_end": 1561347,
      "reason": "إشعار حضور سعد وابن عمر الحكمين جملة مستقلة لا تتمة لحوار القصر."
    },
    {
      "start": 1561174,
      "end": 1561347,
      "context_start": 1561122,
      "context_end": 1561420,
      "reason": "خبر النسب المنقول في سؤال من أنا محفوظ بإسناده ووعيده دون إثبات هوية إضافية."
    },
    {
      "start": 1561347,
      "end": 1561420,
      "context_start": 1561174,
      "context_end": 1561528,
      "reason": "نسب الأم نقل مستقل عن ابن سعد قبل وصف النشأة."
    },
    {
      "start": 1561420,
      "end": 1561528,
      "context_start": 1561347,
      "context_end": 1561608,
      "reason": "وصف السن عند الإسلام والهيئة ينسب إلى ابن مندة ويحفظ اتصال الجملة عبر الصفحة."
    },
    {
      "start": 1561528,
      "end": 1561608,
      "context_start": 1561420,
      "context_end": 1561759,
      "reason": "إشعار مكان الوفاة وتاريخها وحدة زمنية، لا يلحق بوصف الجسم بوصفه رواية واحدة."
    },
    {
      "start": 1561608,
      "end": 1561759,
      "context_start": 1561528,
      "context_end": 1561850,
      "reason": "رواية عائشة في هيئة أبيها وخضابه تحفظ إسنادها وأوصافها متصلة."
    },
    {
      "start": 1561759,
      "end": 1561850,
      "context_start": 1561608,
      "context_end": 1562182,
      "reason": "الوصف المختلف في طول سعد نقل مستقل؛ لا يصحح الوصف السابق أو يحذف تعارضه."
    },
    {
      "start": 1561850,
      "end": 1562182,
      "context_start": 1561759,
      "context_end": 1562339,
      "reason": "خبر استصغار عمير وحمالة السيف يتصل بحضور سعد بدرًا، مع السند والمتن."
    },
    {
      "start": 1562182,
      "end": 1562339,
      "context_start": 1561850,
      "context_end": 1562433,
      "reason": "قول سعد في السبق إلى الإسلام يتصل بالقسم والمدة؛ الرسم أحدا يبقى دون إصلاح."
    },
    {
      "start": 1562339,
      "end": 1562433,
      "context_start": 1562182,
      "context_end": 1562866,
      "reason": "طريق عائشة عن يوم سبق أبيها مستقل عن طريق هاشم السابق."
    },
    {
      "start": 1562433,
      "end": 1562866,
      "context_start": 1562339,
      "context_end": 1563006,
      "reason": "حديث الرمي والجوع والشكوى يتصل بخاتمة لقد خبت والتخريج متفق عليه."
    },
    {
      "start": 1562866,
      "end": 1563006,
      "context_start": 1562433,
      "context_end": 1563322,
      "reason": "خبر أول الرمي من طريق المسعودي مستقل؛ وصل صدر في بآخر سبيل الله عبر الصفحة."
    },
    {
      "start": 1563006,
      "end": 1563322,
      "context_start": 1562866,
      "context_end": 1563551,
      "reason": "خبر الرمي بالسهم بلا نصل ينتهي بضحك النبي، مع أقواله داخل الفقرة."
    },
    {
      "start": 1563322,
      "end": 1563551,
      "context_start": 1563006,
      "context_end": 1563786,
      "reason": "خبر تكرار السهم ثلاثًا يحفظ نقد إسناده المنقطع في نهايته."
    },
    {
      "start": 1563551,
      "end": 1563786,
      "context_start": 1563322,
      "context_end": 1563957,
      "reason": "رواية ابن إسحاق عن مناولة النبل وحدة خبرية بإسناد مستقل."
    },
    {
      "start": 1563786,
      "end": 1563957,
      "context_start": 1563551,
      "context_end": 1564042,
      "reason": "طريق ابن المسيب في الجمع بين الأبوين يتبعه تخريج البخاري وجمع ابن عساكر للطرق."
    },
    {
      "start": 1563957,
      "end": 1564042,
      "context_start": 1563786,
      "context_end": 1564214,
      "reason": "تفصيل طرق خبر قيس تعليق تخريجي متمم، لا حديث جديد."
    },
    {
      "start": 1564042,
      "end": 1564214,
      "context_start": 1563957,
      "context_end": 1564446,
      "reason": "تفصيل طرق حديث علي يحفظ عدد الوجوه وأسماء الناقلين دون إدخالها في المتن."
    },
    {
      "start": 1564214,
      "end": 1564446,
      "context_start": 1564042,
      "context_end": 1564599,
      "reason": "طريق ابن عيينة يضم التفرد والطريق الأصح والاستدراك، فلا يفصل التصحيح عنه."
    },
    {
      "start": 1564446,
      "end": 1564599,
      "context_start": 1564214,
      "context_end": 1564756,
      "reason": "رواية عائشة أنا ابنة المهاجر مسندة بذاتها قبل خبر ابن مسعود."
    },
    {
      "start": 1564599,
      "end": 1564756,
      "context_start": 1564446,
      "context_end": 1565035,
      "reason": "قول ابن مسعود في قتال بدر يبقى مع اختلاف ذكر علقمة في الطريق."
    },
    {
      "start": 1564756,
      "end": 1565035,
      "context_start": 1564599,
      "context_end": 1565089,
      "reason": "خبر سرية رابغ يتصل بتقديم الشعر؛ يبقى آخر الخبر قبل البيتين."
    },
    {
      "start": 1565035,
      "end": 1565089,
      "context_start": 1564756,
      "context_end": 1565149,
      "reason": "بيت سعد الأول حد شعري مستقل محفوظ بالشطرين."
    },
    {
      "start": 1565089,
      "end": 1565149,
      "context_start": 1565035,
      "context_end": 1565344,
      "reason": "بيت سعد الثاني حد شعري مستقل؛ الرقم والإحالة لا يغيران البيت."
    },
    {
      "start": 1565149,
      "end": 1565344,
      "context_start": 1565089,
      "context_end": 1565484,
      "reason": "رواية البخاري في نثل الكنانة متصلة بالقول وارم وتفدية الأبوين."
    },
    {
      "start": 1565344,
      "end": 1565484,
      "context_start": 1565149,
      "context_end": 1565870,
      "reason": "الإسناد العالي لهذا الحديث يتبع رواية مروان السابقة، ولا يخلط بمتن الحراسة اللاحق."
    },
    {
      "start": 1565484,
      "end": 1565870,
      "context_start": 1565344,
      "context_end": 1566261,
      "reason": "خبر الأرق والحراسة يتصل بسؤال من هذا وجواب سعد ونوم النبي."
    },
    {
      "start": 1565870,
      "end": 1566261,
      "context_start": 1565484,
      "context_end": 1566667,
      "reason": "زيارة ابن سعد لأبيه في الغنم وحوار الملك يتصل بحديث العبد التقي الغني الخفي."
    },
    {
      "start": 1566261,
      "end": 1566667,
      "context_start": 1565870,
      "context_end": 1567691,
      "reason": "خبر الترس والرمي يوم الخندق محفوظ بحركاته وحواره ونتيجة الضحك، دون تعيين لفظ يخط الملتبس."
    },
    {
      "start": 1566667,
      "end": 1567691,
      "context_start": 1566261,
      "context_end": 1567977,
      "reason": "خبر سعيد بن زيد في إنكار السب والشهادة للعشرة وحدة منقولة داخل ترجمة سعد؛ لا تنسب الأقوال لصاحب الترجمة."
    },
    {
      "start": 1567691,
      "end": 1567977,
      "context_start": 1566667,
      "context_end": 1568040,
      "reason": "طريق الحر في إنكار سعيد خبر مستقل، مع بقاء الإحالة الحديث في موضعها."
    },
    {
      "start": 1567977,
      "end": 1568040,
      "context_start": 1567691,
      "context_end": 1568314,
      "reason": "متابعة عبد الواحد عن الحر تخريج متمم للخبر السابق."
    },
    {
      "start": 1568040,
      "end": 1568314,
      "context_start": 1567977,
      "context_end": 1568460,
      "reason": "طريق ابن أبي فديك في العشرة مستقل ويذكر أبا عبيدة دون دمج الأسماء في هوية واحدة."
    },
    {
      "start": 1568314,
      "end": 1568460,
      "context_start": 1568040,
      "context_end": 1569073,
      "reason": "طريق سعير عن ابن عمر يذكر عدد العشرة، ويبقى الطريق مستقلًا."
    },
    {
      "start": 1568460,
      "end": 1569073,
      "context_start": 1568314,
      "context_end": 1569200,
      "reason": "حديث حراء من طريق ابن ظالم يجمع ثبات الجبل وتسميات الحاضرين."
    },
    {
      "start": 1569073,
      "end": 1569200,
      "context_start": 1568460,
      "context_end": 1570606,
      "reason": "المتابعة عن محمد بن طلحة وحديث اسكن حراء يتصل بالتقديم وله طرق ومنها."
    },
    {
      "start": 1569200,
      "end": 1570606,
      "context_start": 1569073,
      "context_end": 1570857,
      "reason": "خبر أروى وضفيرة الأرض يحفظ الادعاء والجواب والدعاء ونتيجته وتعليق إرجائه إلى ترجمة سعيد."
    },
    {
      "start": 1570606,
      "end": 1570857,
      "context_start": 1569200,
      "context_end": 1571039,
      "reason": "رؤية الرجلين المقاتلين يوم أحد خبر مستقل بإسناد أحمد."
    },
    {
      "start": 1570857,
      "end": 1571039,
      "context_start": 1570606,
      "context_end": 1571118,
      "reason": "خبر اشتراك الغنيمة والأسرى متصل عبر الصفحة، مع ضمير سعد وعمار."
    },
    {
      "start": 1571039,
      "end": 1571118,
      "context_start": 1570857,
      "context_end": 1571359,
      "reason": "وصف أشد الصحابة أربعة قول مستقل لا يوهم تحقيق كل أوصاف الأخبار المجاورة."
    },
    {
      "start": 1571118,
      "end": 1571359,
      "context_start": 1571039,
      "context_end": 1571569,
      "reason": "طريق أبي يعلى في الداخل من أهل الجنة مستقل بإسناده."
    },
    {
      "start": 1571359,
      "end": 1571569,
      "context_start": 1571118,
      "context_end": 1571770,
      "reason": "طريق رشدين في البشارة يبقى مستقلًا عن الطريق السابق."
    },
    {
      "start": 1571569,
      "end": 1571770,
      "context_start": 1571359,
      "context_end": 1571909,
      "reason": "طريق ابن وهب عن المبهم من لا أتهم يحفظ عدم تعيينه ويصل البشارة بالداخل."
    },
    {
      "start": 1571770,
      "end": 1571909,
      "context_start": 1571569,
      "context_end": 1572532,
      "reason": "خبر سبب نزول ولا تطرد يحفظ عدد الستة وحدود الآية."
    },
    {
      "start": 1571909,
      "end": 1572532,
      "context_start": 1571770,
      "context_end": 1572802,
      "reason": "خبر الأم والثبات يضم الشرط والجواب وامتناع الطعام ثم رجوعها، دون تجزئة الحوار."
    },
    {
      "start": 1572532,
      "end": 1572802,
      "context_start": 1571909,
      "context_end": 1573113,
      "reason": "حديث هذا خالي يتصل بتفسير النسب من جهة أم النبي."
    },
    {
      "start": 1572802,
      "end": 1573113,
      "context_start": 1572532,
      "context_end": 1573517,
      "reason": "خبر العيادة ومسح الوجه والدعاء يحفظ شعور سعد اللاحق والتخريج."
    },
    {
      "start": 1573113,
      "end": 1573517,
      "context_start": 1572802,
      "context_end": 1573680,
      "reason": "خبر بكاء سعد وتمني الموت يتصل بالنهي عنه وشرط إن كنت خلقت للجنة، دون اختزال القيد."
    },
    {
      "start": 1573517,
      "end": 1573680,
      "context_start": 1573113,
      "context_end": 1573771,
      "reason": "طريق قيس في الاستجابة لسعد قول مستقل بإسناده."
    },
    {
      "start": 1573680,
      "end": 1573771,
      "context_start": 1573517,
      "context_end": 1573924,
      "reason": "متابعة جعفر بن عون تتصل بحديث الاستجابة السابق."
    },
    {
      "start": 1573771,
      "end": 1573924,
      "context_start": 1573680,
      "context_end": 1574545,
      "reason": "خبر دعاء أحد ثلاث مرات مستقل عن طريق قيس."
    },
    {
      "start": 1573924,
      "end": 1574545,
      "context_start": 1573771,
      "context_end": 1575275,
      "reason": "دعاء سعد وابن جحش وحوارهما خبر واحد ينتهي بالمقارنة بين الدعوتين."
    },
    {
      "start": 1574545,
      "end": 1575275,
      "context_start": 1573924,
      "context_end": 1575687,
      "reason": "شكوى أهل الكوفة والتحقق من المساجد وادعاء أبي سعدة والجواب والدعاء تحفظ كلها مع الشرط."
    },
    {
      "start": 1575275,
      "end": 1575687,
      "context_start": 1574545,
      "context_end": 1575938,
      "reason": "طريق مصعب في الشكوى ينتهي بنتيجة الدعاء وفتنة المختار؛ تبقى الاتهامات منسوبة لقائلها."
    },
    {
      "start": 1575687,
      "end": 1575938,
      "context_start": 1575275,
      "context_end": 1576591,
      "reason": "خبر الجارية والدرة يضم الخصومة وعرض القصاص والعفو، دون فصل النتيجة عن المقدمة."
    },
    {
      "start": 1575938,
      "end": 1576591,
      "context_start": 1575687,
      "context_end": 1576801,
      "reason": "خبر المال بين سعد وابن مسعود يضم إنكار هاشم وتوقف الدعاء وتعليق القرض، مع إبقاء لاق الملتبس."
    },
    {
      "start": 1576591,
      "end": 1576801,
      "context_start": 1575938,
      "context_end": 1576898,
      "reason": "التقديم لفتوح العراق والقادسية والمدائن وجلولاء وحدة تاريخية موجزة."
    },
    {
      "start": 1576801,
      "end": 1576898,
      "context_start": 1576591,
      "context_end": 1576953,
      "reason": "إسناد قبيصة يقدّم قول ابن عمه والشعر؛ لا يفصل السند عن مقدمته."
    },
    {
      "start": 1576898,
      "end": 1576953,
      "context_start": 1576801,
      "context_end": 1577014,
      "reason": "البيت الأول في القادسية مستقل شعريًا، ولفظ معصم الملتبس باقٍ على الأصل."
    },
    {
      "start": 1576953,
      "end": 1577014,
      "context_start": 1576898,
      "context_end": 1577180,
      "reason": "البيت الثاني مستقل مع الحفاظ على ألفاظه ورمز ms التقني."
    },
    {
      "start": 1577014,
      "end": 1577180,
      "context_start": 1576953,
      "context_end": 1577219,
      "reason": "رد سعد على الشعر ونتيجة الدعاء يتصل بعذر القروح عن شهود القتال."
    },
    {
      "start": 1577180,
      "end": 1577219,
      "context_start": 1577014,
      "context_end": 1577442,
      "reason": "متابعة سيف بن عمر تبقى طريقًا مذكورًا ولا تنشئ متنًا جديدًا."
    },
    {
      "start": 1577219,
      "end": 1577442,
      "context_start": 1577180,
      "context_end": 1577560,
      "reason": "خبر النيل من علي ونهي سعد والدعاء ونتيجته مع تقديم كثرة الطرق وحدة سياقية."
    },
    {
      "start": 1577442,
      "end": 1577560,
      "context_start": 1577219,
      "context_end": 1577600,
      "reason": "متابعة الزبير بن بكار طريق مستقل يلتقي بخبر عامر."
    },
    {
      "start": 1577560,
      "end": 1577600,
      "context_start": 1577442,
      "context_end": 1577676,
      "reason": "طريق أبي كريب إشارة متابعة موجزة لا يندمج في اسم أبي أسامة."
    },
    {
      "start": 1577600,
      "end": 1577676,
      "context_start": 1577560,
      "context_end": 1577845,
      "reason": "طريق ابن حميد يثبت اختلاف اسم الراوي محمد بن محمد بن الأسود."
    },
    {
      "start": 1577676,
      "end": 1577845,
      "context_start": 1577600,
      "context_end": 1577884,
      "reason": "الإسناد المقروء إلى الأنصاري متابعة للخبر السابق لا مندرج في متن الدعاء."
    },
    {
      "start": 1577845,
      "end": 1577884,
      "context_start": 1577676,
      "context_end": 1578265,
      "reason": "متابعة ابن علية تذكر الطريق فقط دون إنشاء شاهد معنى مستقل."
    },
    {
      "start": 1577884,
      "end": 1578265,
      "context_start": 1577845,
      "context_end": 1578456,
      "reason": "طريق ابن جدعان يضم النهي عن الوقيعة والصلاة والدعاء ثم تعليق الكرامة المنقول."
    },
    {
      "start": 1578265,
      "end": 1578456,
      "context_start": 1577884,
      "context_end": 1578650,
      "reason": "رواية جرير في الجارية تحفظ سياق السؤال والجواب والدعاء."
    },
    {
      "start": 1578456,
      "end": 1578650,
      "context_start": 1578265,
      "context_end": 1578836,
      "reason": "خبر المرأة المتطلعة يبقى مع نقد مينا متروك، فلا يعرض الخبر مثبتًا بلا نقد."
    },
    {
      "start": 1578650,
      "end": 1578836,
      "context_start": 1578456,
      "context_end": 1578987,
      "reason": "رواية تأخير الموت لأجل الأبناء محفوظة مع إسنادها مستقلة."
    },
    {
      "start": 1578836,
      "end": 1578987,
      "context_start": 1578650,
      "context_end": 1579148,
      "reason": "قول خليفة يجمع تاريخ القادسية والشكوى والعزل دون إسقاط اختلاف تواريخ الفتوح."
    },
    {
      "start": 1578987,
      "end": 1579148,
      "context_start": 1578836,
      "context_end": 1579199,
      "reason": "قول الليث في تاريخ جلولاء يتصل بالتعليق على القتل والغنيمة."
    },
    {
      "start": 1579148,
      "end": 1579199,
      "context_start": 1578987,
      "context_end": 1579270,
      "reason": "تسمية جلولاء فتح الفتوح خبر موجز مستقل عن تحديد سنتها."
    },
    {
      "start": 1579199,
      "end": 1579270,
      "context_start": 1579148,
      "context_end": 1579493,
      "reason": "خبر عزل المغيرة وتولية سعد ينسب إلى الزهري."
    },
    {
      "start": 1579270,
      "end": 1579493,
      "context_start": 1579199,
      "context_end": 1579768,
      "reason": "حديث الشورى والوصية بالاستعانة بسعد يحفظ نفي الضعف والخيانة مع خبره."
    },
    {
      "start": 1579493,
      "end": 1579768,
      "context_start": 1579270,
      "context_end": 1580223,
      "reason": "قول اعتزال القتال يتصل بشرط السيف ذي العينين واللسان ومتابعة معمر."
    },
    {
      "start": 1579768,
      "end": 1580223,
      "context_start": 1579493,
      "context_end": 1580809,
      "reason": "خبر زيارة عامر ورفض رئاسة الفتنة يحفظ السند والشرط والحديث الختامي."
    },
    {
      "start": 1580223,
      "end": 1580809,
      "context_start": 1579768,
      "context_end": 1581410,
      "reason": "خبر علي والحكمين يضم الاعتراض والرد والإشادة بمنزل سعد وابن عمر دون تقرير كلام المعترض."
    },
    {
      "start": 1580809,
      "end": 1581683,
      "context_start": 1580223,
      "context_end": 1582624,
      "reason": "رؤيا حسين تحفظ تقديم النوم وتسلسل المنام قبل قصها على سعد. تفسير سعد للرؤيا وإرشاده إلى الغنم متعلق بالمنام السابق لا وحي مستقل."
    },
    {
      "start": 1581683,
      "end": 1582624,
      "context_start": 1581410,
      "context_end": 1582759,
      "reason": "حديث المرض والوصية يجمع سؤال المال والشطر والثلث والإنفاق والهجرة والدعاء والتخريج."
    },
    {
      "start": 1582624,
      "end": 1582759,
      "context_start": 1581683,
      "context_end": 1582999,
      "reason": "إرشاد الناس إلى سعد أيام الهيج خبر مستقل من طريق الحسن."
    },
    {
      "start": 1582759,
      "end": 1582999,
      "context_start": 1582624,
      "context_end": 1583114,
      "reason": "خبر مخاطبة معاوية يحفظ سياق عدم السلام بالإمرة والجواب، دون حكم هوية جديد."
    },
    {
      "start": 1582999,
      "end": 1583114,
      "context_start": 1582759,
      "context_end": 1583281,
      "reason": "تعليق المؤلف على اعتزال الفتنة يحفظ نفي حضور الوقائع المذكورة."
    },
    {
      "start": 1583114,
      "end": 1583281,
      "context_start": 1582999,
      "context_end": 1583537,
      "reason": "خبر الجواري والنوم خبر مستقل بإسناده ولا يخلط بوقائع الوفاة اللاحقة."
    },
    {
      "start": 1583281,
      "end": 1583537,
      "context_start": 1583114,
      "context_end": 1583714,
      "reason": "حديث الاحتضار وطمأنة الابن يتصل بتعليق صدق والله؛ السياق منقول كما ورد."
    },
    {
      "start": 1583537,
      "end": 1583714,
      "context_start": 1583281,
      "context_end": 1583885,
      "reason": "خبر جبة بدر والوصية بالكفن متصل عبر الصفحة."
    },
    {
      "start": 1583714,
      "end": 1583885,
      "context_start": 1583537,
      "context_end": 1583974,
      "reason": "خبر الزكاة والميراث يثبت الأرقام كما وردت دون نقلها إلى حواشٍ."
    },
    {
      "start": 1583885,
      "end": 1583974,
      "context_start": 1583714,
      "context_end": 1584102,
      "reason": "خبر القصر والاعتزال الأخير مستقل عن مقدار المال."
    },
    {
      "start": 1583974,
      "end": 1584102,
      "context_start": 1583885,
      "context_end": 1584188,
      "reason": "قول أم سلمة عند الجنازة يحفظ سبب البكاء وعبارتها."
    },
    {
      "start": 1584102,
      "end": 1584188,
      "context_start": 1583974,
      "context_end": 1584257,
      "reason": "قول آخر المهاجرين وفاة خبر مستقل لا يحذف اختلاف تحديد السنة."
    },
    {
      "start": 1584188,
      "end": 1584257,
      "context_start": 1584102,
      "context_end": 1584362,
      "reason": "قول المدائني والجماعة يحدد سنة الوفاة الأولى."
    },
    {
      "start": 1584257,
      "end": 1584362,
      "context_start": 1584188,
      "context_end": 1584462,
      "reason": "رواية نوح تذكر العمر والسنة المختلفة مع إسنادها."
    },
    {
      "start": 1584362,
      "end": 1584462,
      "context_start": 1584257,
      "context_end": 1584562,
      "reason": "الأقوال اللاحقة في سنة سبع وثمان تبقى مع ترجيح الأول كما ورد، دون تصحيح المرجع المخزن."
    },
    {
      "start": 1584462,
      "end": 1584562,
      "context_start": 1584362,
      "context_end": 1584562,
      "reason": "إحصاء مسند بقي والصحيح خاتمة عددية مستقلة."
    }
  ],
