  "criticism": [
    {
      "start": 1586124,
      "end": 1586210,
      "context_start": 1585746,
      "context_end": 1586371,
      "kind": "isnad",
      "reason": "الصلاح مقيد بالانقطاع وسبب عدم السماع، مع الطريق المقابل."
    },
    {
      "start": 1588676,
      "end": 1588737,
      "context_start": 1587838,
      "context_end": 1588854,
      "kind": "hadith",
      "reason": "نقل ألفاظ التقويم مع التفرد والرواية كتابة."
    },
    {
      "start": 1589160,
      "end": 1589202,
      "context_start": 1588812,
      "context_end": 1589283,
      "kind": "hadith",
      "reason": "وصف الإرسال وتعليل المؤلف في قصة ورقة وبلال."
    },
    {
      "start": 1589760,
      "end": 1589778,
      "context_start": 1589449,
      "context_end": 1589869,
      "kind": "narrator",
      "reason": "نقد راو في طريق زيد الأب لا في صاحب الترجمة."
    },
    {
      "start": 1590345,
      "end": 1590374,
      "context_start": 1590026,
      "context_end": 1591085,
      "kind": "report",
      "reason": "تعليق المؤلف على اختلاف لفظ رواية السفرة مع تفسيره اللاحق."
    },
    {
      "start": 1591218,
      "end": 1591222,
      "context_start": 1591085,
      "context_end": 1591262,
      "kind": "hadith",
      "reason": "وصف الخبر عن زيد الأب بالغرابة."
    },
    {
      "start": 1591865,
      "end": 1591877,
      "context_start": 1591863,
      "context_end": 1591988,
      "kind": "isnad",
      "reason": "وصف إسناد خبر صلاة زيد الأب قبل متنه."
    },
    {
      "start": 1598960,
      "end": 1598998,
      "context_start": 1598752,
      "context_end": 1599070,
      "kind": "report",
      "reason": "تعليق على اختلاف موضع الوفاة وسنتها."
    },
    {
      "start": 1599857,
      "end": 1599881,
      "context_start": 1599070,
      "context_end": 1601959,
      "kind": "hadith",
      "reason": "تحذير صريح قبل متن المؤاخاة، ويتبعه نقد الحديث ووصفه بالموضوع."
    },
    {
      "start": 1601924,
      "end": 1601957,
      "context_start": 1599855,
      "context_end": 1602056,
      "kind": "hadith",
      "reason": "نقد زيد بن أبي أوفى في سياق الحديث الموصوف بالوضع، لا سعيد ولا زيد الأب."
    },
    {
      "start": 1602693,
      "end": 1602716,
      "context_start": 1602056,
      "context_end": 1602804,
      "kind": "hadith",
      "reason": "تفرد شبابة وعدم صحة طريق آخر للمؤاخاة، مع ذكر المحفوظ بعده."
    }
  ],
  "paragraph_notes": [
    {
      "start": 1584562,
      "end": 1584613,
      "context_start": 1584562,
      "context_end": 1584712,
      "reason": "عنوان المصدر باسم سعيد مستقل عن متن التعريف."
    },
    {
      "start": 1584613,
      "end": 1584986,
      "context_start": 1584562,
      "context_end": 1585065,
      "reason": "استكمال النسب والكنية والنسبتين بطاقة تعريف متصلة. السابقة والبشارة وصف افتتاحي متمم للبطاقة. خبر المشاهد ونيابة دمشق متصل عبر الصفحة ويحفظ من ولاه."
    },
    {
      "start": 1584986,
      "end": 1585065,
      "context_start": 1584818,
      "context_end": 1585218,
      "reason": "إحصاء مرويات الصحيحين مستقل عن الولاية."
    },
    {
      "start": 1585065,
      "end": 1585218,
      "context_start": 1584986,
      "context_end": 1585746,
      "reason": "أسماء من روى عنه جملة متصلة لا تفصل عند كل اسم."
    },
    {
      "start": 1585218,
      "end": 1585746,
      "context_start": 1585065,
      "context_end": 1586371,
      "reason": "إسناد الكمأة ينتهي بالمتن والتخريج والبدل العالي، مع التواريخ كما في المصدر."
    },
    {
      "start": 1585746,
      "end": 1586371,
      "context_start": 1585218,
      "context_end": 1586811,
      "reason": "حديث الأرض والمال يحفظ استدراك الانقطاع وذكر الواسطة والطريق الآخر والتخريج."
    },
    {
      "start": 1586371,
      "end": 1586811,
      "context_start": 1585746,
      "context_end": 1587838,
      "reason": "خبر والد سعيد يجمع طلب الحنيفية مع تقييد عدم إدراك الشريعة ونقل البعث وحده."
    },
    {
      "start": 1586811,
      "end": 1587838,
      "context_start": 1586371,
      "context_end": 1588812,
      "reason": "خبر النفر من قريش يتصل بمواقف ورقة وزيد وخروج زيد إلى الشام وأذى عمه."
    },
    {
      "start": 1587838,
      "end": 1588812,
      "context_start": 1586811,
      "context_end": 1589283,
      "reason": "إسناد أسماء وخبر إنقاذ الموءودة يحفظ التصحيح والتفرد والكتابة والتعليق في البخاري."
    },
    {
      "start": 1588812,
      "end": 1589283,
      "context_start": 1587838,
      "context_end": 1589449,
      "reason": "خبر ورقة وبلال يتصل بنقد الإرسال وتاريخ وفاة ورقة؛ لا تفصل قصة التعذيب عن نقدها."
    },
    {
      "start": 1589283,
      "end": 1589449,
      "context_start": 1588812,
      "context_end": 1589780,
      "reason": "دعاء ورقة والسجود على راحته خبر مستقل عن زيد."
    },
    {
      "start": 1589449,
      "end": 1589780,
      "context_start": 1589283,
      "context_end": 1590026,
      "reason": "خبر السفرة والنصب ينتهي بنقد المسعودي ليس بحجة؛ يتصل الخبر بتقييده."
    },
    {
      "start": 1589780,
      "end": 1590026,
      "context_start": 1589449,
      "context_end": 1590343,
      "reason": "زيادة سؤال سعيد عن أبيه تتبع طريق المسعودي مع نسبة الاستغفار كما ورد."
    },
    {
      "start": 1590026,
      "end": 1590343,
      "context_start": 1589780,
      "context_end": 1591085,
      "reason": "طريق إبراهيم الحربي في السفرة مستقل ويهيئ تفسير اختلاف اللفظ."
    },
    {
      "start": 1590343,
      "end": 1591085,
      "context_start": 1590026,
      "context_end": 1591262,
      "reason": "تعليق اللفظ المليح والإباحة والعصمة قبل التشريع سياق تفسيري متصل عبر الصفحة، لا حكم جديد من التطبيق."
    },
    {
      "start": 1591085,
      "end": 1591262,
      "context_start": 1590343,
      "context_end": 1591467,
      "reason": "خبر الدوحتين محفوظ مع وصفه غريبًا وطريق الباغندي."
    },
    {
      "start": 1591262,
      "end": 1591467,
      "context_start": 1591085,
      "context_end": 1591863,
      "reason": "خبر زيد عند الكعبة والتحذير من الزنى مستقل بإسناده."
    },
    {
      "start": 1591467,
      "end": 1591863,
      "context_start": 1591262,
      "context_end": 1591988,
      "reason": "خبر الراهب وطلب دين إبراهيم يحفظ الحوار والبشارة المنقولة في سياق الرحلة."
    },
    {
      "start": 1591863,
      "end": 1591988,
      "context_start": 1591467,
      "context_end": 1592026,
      "reason": "خبر الصلاة عند زوال الشمس يبدأ بوصف الإسناد بالضعف؛ لا يفصل القيد عن خبره."
    },
    {
      "start": 1591988,
      "end": 1592026,
      "context_start": 1591863,
      "context_end": 1592079,
      "reason": "تقديم الضحاك للشعر يظل قبل الأبيات دون دمج بيتين."
    },
    {
      "start": 1592026,
      "end": 1592079,
      "context_start": 1591988,
      "context_end": 1592133,
      "reason": "البيت الأول مستقل بشطريه في إسلام الوجه."
    },
    {
      "start": 1592079,
      "end": 1592133,
      "context_start": 1592026,
      "context_end": 1592198,
      "reason": "البيت الثاني مستقل في سياق المطر وحفظ ألفاظه."
    },
    {
      "start": 1592133,
      "end": 1592198,
      "context_start": 1592079,
      "context_end": 1592255,
      "reason": "البيت الثالث مستقل مع إحالة الصفحة في موضعها."
    },
    {
      "start": 1592198,
      "end": 1592255,
      "context_start": 1592133,
      "context_end": 1592440,
      "reason": "البيت الرابع مستقل دون تصحيح الوزن أو اللفظ."
    },
    {
      "start": 1592255,
      "end": 1592440,
      "context_start": 1592198,
      "context_end": 1592511,
      "reason": "خبر مقتل زيد من طريق هشام بلاغ مستقل لا يدمج مع الخبر المسند اللاحق."
    },
    {
      "start": 1592440,
      "end": 1592511,
      "context_start": 1592255,
      "context_end": 1592945,
      "reason": "قول الواقدي وابن إسحاق يثبت اختلاف مكان الموت، دون ترجيح جديد."
    },
    {
      "start": 1592511,
      "end": 1592945,
      "context_start": 1592440,
      "context_end": 1594156,
      "reason": "خبر أسفل بلدح يحفظ الرفض وتعليق عيب ذبائح قريش والتخريج في وحدة."
    },
    {
      "start": 1592945,
      "end": 1594156,
      "context_start": 1592511,
      "context_end": 1594792,
      "reason": "رواية أبي أسامة في السفرة والنصب محفوظة بطول الحوار واللفظ كذا قال، قبل مناقشة وجهي الذبح."
    },
    {
      "start": 1594156,
      "end": 1594792,
      "context_start": 1592945,
      "context_end": 1594897,
      "reason": "الوجهان والتعليق على النية والتوقف عن الإفصاح تفسير متصل للخبر لا رواية جديدة."
    },
    {
      "start": 1594792,
      "end": 1594897,
      "context_start": 1594156,
      "context_end": 1594957,
      "reason": "تقديم رثاء ورقة يذكر زمن الوفاة المفهوم قبل المبعث ثم يحيل إلى الأبيات."
    },
    {
      "start": 1594897,
      "end": 1594957,
      "context_start": 1594792,
      "context_end": 1595018,
      "reason": "بيت الرثاء الأول مستقل بشطريه."
    },
    {
      "start": 1594957,
      "end": 1595018,
      "context_start": 1594897,
      "context_end": 1595078,
      "reason": "بيت الرثاء الثاني مستقل دون تغيير الرسم هيا."
    },
    {
      "start": 1595018,
      "end": 1595078,
      "context_start": 1594957,
      "context_end": 1595139,
      "reason": "بيت الرثاء الثالث مستقل عن تفسير السياق."
    },
    {
      "start": 1595078,
      "end": 1595139,
      "context_start": 1595018,
      "context_end": 1595201,
      "reason": "بيت الرثاء الرابع مستقل، مع بقاء جهة الخطاب."
    },
    {
      "start": 1595139,
      "end": 1595201,
      "context_start": 1595078,
      "context_end": 1595389,
      "reason": "بيت الرثاء الخامس مستقل نهاية المقطوعة."
    },
    {
      "start": 1595201,
      "end": 1595389,
      "context_start": 1595139,
      "context_end": 1595438,
      "reason": "عد سعيد في البدريين يفسر الغياب والقدوم وضرب السهم والأجر وينسب الأقوال."
    },
    {
      "start": 1595389,
      "end": 1595438,
      "context_start": 1595201,
      "context_end": 1595503,
      "reason": "زوجة سعيد ونسبها خبر تعريفي قبل زمن الإسلام."
    },
    {
      "start": 1595438,
      "end": 1595503,
      "context_start": 1595389,
      "context_end": 1595689,
      "reason": "زمن إسلام سعيد قبل دار الأرقم خبر مستقل موجز."
    },
    {
      "start": 1595503,
      "end": 1595689,
      "context_start": 1595438,
      "context_end": 1595737,
      "reason": "قول سعيد في توثيق عمر له ولأخته يحفظ التعريض بمقتل عثمان دون نسبة فعل جديد إليه."
    },
    {
      "start": 1595689,
      "end": 1595737,
      "context_start": 1595503,
      "context_end": 1596234,
      "reason": "إحالة المؤلف إلى إسلام عمر تعليق مرجعي لا يحذف."
    },
    {
      "start": 1595737,
      "end": 1596234,
      "context_start": 1595689,
      "context_end": 1596287,
      "reason": "خبر بعث طلحة وسعيد لاستطلاع العير يتصل بالعودة وضرب الأجر والسهم."
    },
    {
      "start": 1596234,
      "end": 1596287,
      "context_start": 1595737,
      "context_end": 1596348,
      "reason": "إحصاء مشاهد سعيد متمم لسيرته وليس ذيلًا لإسناد سابق."
    },
    {
      "start": 1596287,
      "end": 1596348,
      "context_start": 1596234,
      "context_end": 1596464,
      "reason": "الإحالة إلى أحاديث البشارة والشهادة تعقيب على السير لا حديث مستحدث."
    },
    {
      "start": 1596348,
      "end": 1596464,
      "context_start": 1596287,
      "context_end": 1596882,
      "reason": "سؤال عبد الله لأبيه في الشهادة يتصل بالإحالة إلى حديث سعيد."
    },
    {
      "start": 1596464,
      "end": 1596882,
      "context_start": 1596348,
      "context_end": 1596971,
      "reason": "دعوى أروى والأرض تحفظ الادعاء والجواب والشرط والدعاء والنتيجة وتخريج مسلم معًا."
    },
    {
      "start": 1596882,
      "end": 1596971,
      "context_start": 1596464,
      "context_end": 1597054,
      "reason": "متابعة عبد العزيز تذكر الطريق ونحوه دون إنشاء متن بديل."
    },
    {
      "start": 1596971,
      "end": 1597054,
      "context_start": 1596882,
      "context_end": 1597174,
      "reason": "متابعة المغيرة تذكر طريق نافع وتفصل الرواة عن الهوية المقصودة."
    },
    {
      "start": 1597054,
      "end": 1597174,
      "context_start": 1596971,
      "context_end": 1597439,
      "reason": "خبر طلب أروى الدعاء والجواب متابعة مستقلة لا يغني عن سياق الدعوى السابق."
    },
    {
      "start": 1597174,
      "end": 1597439,
      "context_start": 1597054,
      "context_end": 1597728,
      "reason": "تعليق ترك سعيد من الشورى يحفظ تعليل المؤلف وفرض القول المعارض معًا، والرسم سعيدا يبقى دون إصلاح."
    },
    {
      "start": 1597439,
      "end": 1597728,
      "context_start": 1597174,
      "context_end": 1598154,
      "reason": "خبر بيعة يزيد يحفظ شرط مروان وسؤال الجندي في سياق منقول مستقل."
    },
    {
      "start": 1597728,
      "end": 1598154,
      "context_start": 1597439,
      "context_end": 1598352,
      "reason": "حديث حراء بإسناده واختلاف حصين في الواسطة يحفظ أسماء الحاضرين."
    },
    {
      "start": 1598154,
      "end": 1598352,
      "context_start": 1597728,
      "context_end": 1598532,
      "reason": "خبر استصراخ ابن عمر وترك الجمعة يتصل بالتخريج، لا يفصل بحكم فقهي مستحدث."
    },
    {
      "start": 1598352,
      "end": 1598532,
      "context_start": 1598154,
      "context_end": 1598672,
      "reason": "خبر التذريب والتحنيط بالمسك حوار كامل يتصل بوضع الوفاة."
    },
    {
      "start": 1598532,
      "end": 1598672,
      "context_start": 1598352,
      "context_end": 1598752,
      "reason": "رواية عائشة في الغسل والكفن والجنازة خبر مستقل."
    },
    {
      "start": 1598672,
      "end": 1598752,
      "context_start": 1598532,
      "context_end": 1598911,
      "reason": "قول مالك يجمع موضع وفاة سعيد وسعد دون دمج الشخصين."
    },
    {
      "start": 1598752,
      "end": 1598911,
      "context_start": 1598672,
      "context_end": 1598958,
      "reason": "قول الواقدي في السنة والعمر والقبر يحفظ موافقة الناقلين بعده."
    },
    {
      "start": 1598911,
      "end": 1598958,
      "context_start": 1598752,
      "context_end": 1599000,
      "reason": "وصف هيئة سعيد نقل مستقل عن زمن الوفاة."
    },
    {
      "start": 1598958,
      "end": 1599000,
      "context_start": 1598911,
      "context_end": 1599070,
      "reason": "قول الكوفة يظل موسومًا بالشذوذ كما ورد."
    },
    {
      "start": 1599000,
      "end": 1599070,
      "context_start": 1598958,
      "context_end": 1599222,
      "reason": "القول الآخر في سنة الوفاة محفوظ دون ترجيح جديد."
    },
    {
      "start": 1599070,
      "end": 1599222,
      "context_start": 1599000,
      "context_end": 1599855,
      "reason": "خاتمة سيرة العشرة وصف وتقويم من المصدر، لا اعتماد يصدره التطبيق."
    },
    {
      "start": 1599222,
      "end": 1599855,
      "context_start": 1599070,
      "context_end": 1599883,
      "reason": "المناقشة الجدلية تحافظ على نفي الافتراء والفرض والاستدلال ونسبة الكلام للمصدر."
    },
    {
      "start": 1599855,
      "end": 1601959,
      "context_start": 1599222,
      "context_end": 1602056,
      "reason": "تقديم الحديث المشترك يصرح بالنكارة قبل المتن الطويل؛ لا يعرض بوصفه حديثًا صحيحًا. خبر المؤاخاة الطويل يحفظ الإسناد والأقوال والانتقالات عبر الصفحات كما ورد دون تحويلها لفضائل معتمدة. نقد زيد والحديث الموضوع يلزم لفهم الخبر السابق ولا ينفصل عنه في المراجعة."
    },
    {
      "start": 1601959,
      "end": 1602056,
      "context_start": 1601912,
      "context_end": 1602222,
      "reason": "طريق الطبري وتغير الواسطة متابعة تخريجية تحفظ لفظ فأسقط منه عن رجل."
    },
    {
      "start": 1602056,
      "end": 1602222,
      "context_start": 1601959,
      "context_end": 1602358,
      "reason": "طريق السمري يحفظ السند البديل ولا يستنتج اتحاد هوية الرجل المبهم."
    },
    {
      "start": 1602222,
      "end": 1602358,
      "context_start": 1602056,
      "context_end": 1602691,
      "reason": "طريق مطين المختصر مستقل مع اختلاف الصحابي في الرواية."
    },
    {
      "start": 1602358,
      "end": 1602804,
      "context_start": 1602222,
      "context_end": 1602898,
      "reason": "طريق شبابة يذكر المخالفة في الأسماء والزيادة والنقصان قبل نقده. نقد التفرد وعدم الصحة يتصل بطريق شبابة لا بالمحفوظ بعده. بيان المحفوظ في مؤاخاة المهاجرين والأنصار يأتي بعد نقد الطرق، دون تأليف درجة جديدة."
    },
    {
      "start": 1602804,
      "end": 1602898,
      "context_start": 1602718,
      "context_end": 1602898,
      "reason": "إحصاء مرويات سعيد في الصحيحين خاتمة مستقلة."
    }
  ],
