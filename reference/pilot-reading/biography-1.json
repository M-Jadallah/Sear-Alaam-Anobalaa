  "criticism": [
    {
      "start": 1488161,
      "end": 1488213,
      "context_start": 1487279,
      "context_end": 1488214,
      "kind": "hadith",
      "reason": "تقويم الحديث بلفظه في سياق النقل عن الترمذي؛ لا ينشئ العرض حكمًا جديدًا ولا يساوي الغرابة بالضعف."
    },
    {
      "start": 1489298,
      "end": 1489348,
      "context_start": 1489166,
      "context_end": 1489349,
      "kind": "report",
      "reason": "تعليق النص المشروط على مدة الهجرة إلى الحبشة؛ يبقى شرط «إن كان» ظاهرًا ولا تتحول الرواية إلى جزم."
    },
    {
      "start": 1489937,
      "end": 1489957,
      "context_start": 1489935,
      "context_end": 1490064,
      "kind": "hadith",
      "reason": "إثبات تعدد وجوه الخبر كما يذكر النص، مرتبط بحديث أمانة أبي عبيدة اللاحق."
    },
    {
      "start": 1491084,
      "end": 1491273,
      "context_start": 1490860,
      "context_end": 1491286,
      "kind": "isnad",
      "reason": "يعرض النص رواية حماد ومخالفة الجماعة له في طريق الخبر ونص الجواب؛ تُبرز المخالفة مع البديل دون ترجيح مستحدث."
    },
    {
      "start": 1491747,
      "end": 1491771,
      "context_start": 1491286,
      "context_end": 1491772,
      "kind": "hadith",
      "reason": "عبارة الاتفاق الواردة بعد حديث حذيفة، مرتبطة بهذا الخبر بعينه لا بجميع ما يليه."
    },
    {
      "start": 1491774,
      "end": 1491823,
      "context_start": 1491772,
      "context_end": 1491922,
      "kind": "hadith",
      "reason": "نقل الاتفاق على طريق خالد الحذاء إلى أنس كما في المصدر؛ يبقى الطريق والمتن في السياق."
    },
    {
      "start": 1493650,
      "end": 1493660,
      "context_start": 1492954,
      "context_end": 1493708,
      "kind": "hadith",
      "reason": "وصف النص خبر الخدم والدواب والوصية بالغرابة؛ لا يستنتج العارض منه ضعف الحديث."
    },
    {
      "start": 1493859,
      "end": 1493873,
      "context_start": 1493708,
      "context_end": 1493874,
      "kind": "isnad",
      "reason": "نقد النص لإرسال خبر الحسن السابق، مع حفظ الإشارة الرقمية في الملحق وعدم عزله عن الخبر."
    },
    {
      "start": 1494450,
      "end": 1494566,
      "context_start": 1494293,
      "context_end": 1494567,
      "kind": "isnad",
      "reason": "بيان اختلاف طريق أثر ابن مسعود بين أبي عبيدة وأبي الأحوص كما ورد، دون حسم هوية أو تصحيح من الوكيل."
    },
    {
      "start": 1494636,
      "end": 1494706,
      "context_start": 1494567,
      "context_end": 1494707,
      "kind": "report",
      "reason": "تقييد تاريخي لمعنى تولية بيت المال في الخبر السابق؛ لا يُختزل النقل بحيث يوهم وجود البناء المؤسسي قبله."
    },
    {
      "start": 1501871,
      "end": 1501972,
      "context_start": 1501715,
      "context_end": 1501973,
      "kind": "report",
      "reason": "ينقل النص انفرادًا في تاريخ الوفاة مقابل سنة ثمان عشرة التي سبقت؛ عرض للاختلاف لا اختيار لتاريخ نهائي."
    }
  ]
}
