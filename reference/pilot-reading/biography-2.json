  "criticism": [
    {
      "start": 1503725,
      "end": 1503736,
      "context_start": 1503703,
      "context_end": 1503804,
      "kind": "isnad",
      "reason": "وصف الإسناد بالحسن في النص نفسه، متصل بخبر «أوجب طلحة» دون تعميم على الأخبار المجاورة."
    },
    {
      "start": 1504697,
      "end": 1504708,
      "context_start": 1503941,
      "context_end": 1504709,
      "kind": "narrator",
      "reason": "تقويم رواة خبر الدفاع يوم أحد كما ورد؛ لا تُحوّل العبارة إلى ادعاء صحة جميع تفاصيل الرواية من الموقع."
    },
    {
      "start": 1506502,
      "end": 1506555,
      "context_start": 1506218,
      "context_end": 1506568,
      "kind": "isnad",
      "reason": "يذكر النص شذوذ صورة الإسناد عند أبي يعلى بعد ذكر رواية الآخرين؛ تُحفظ أسماء الطريق والمخالفة كما هي."
    },
    {
      "start": 1507001,
      "end": 1507012,
      "context_start": 1506768,
      "context_end": 1507013,
      "kind": "isnad",
      "reason": "الحكم المنقول في المصدر على إسناد خبر ألقاب طلحة، دون تعميمه على كل ما ورد في بابه."
    },
    {
      "start": 1508429,
      "end": 1508458,
      "context_start": 1508226,
      "context_end": 1508471,
      "kind": "isnad",
      "reason": "إبقاء النقد المركب كاملًا: انقطاع الإسناد وضعف الكديمي في الخبر السابق، دون إسقاط أحد القيدين."
    },
    {
      "start": 1512964,
      "end": 1512969,
      "context_start": 1512753,
      "context_end": 1512970,
      "kind": "isnad",
      "reason": "نقد إرسال الخبر الذي يصف ترحم علي على طلحة؛ يظل الإرسال مربوطًا بهذه الرواية ولا يُنسب إلى خبر مجاور."
    },
    {
      "start": 1513449,
      "end": 1513751,
      "context_start": 1513076,
      "context_end": 1513752,
      "kind": "narrator",
      "reason": "حجة طلحة المنقولة في سعة سماع أبي هريرة والرد على التشكيك فيه، بجميع تعليلها وسؤالها الختامي؛ ليست تصحيحًا آليًا لأحاديثه."
    },
    {
      "start": 1515352,
      "end": 1515444,
      "context_start": 1515141,
      "context_end": 1515445,
      "kind": "report",
      "reason": "استغراب صاحب النص مقدار التركة المنقول عن ابن الجوزي، في سياق الأرقام السابقة؛ لا يُستبدل الاستغراب بحكم جازم بالكذب."
    },
    {
      "start": 1515759,
      "end": 1515807,
      "context_start": 1515445,
      "context_end": 1515808,
      "kind": "report",
      "reason": "اختلاف منقول في تعيين من رأى المنام؛ يُعرض بوصفه اختلافًا في الرواية لا إثباتًا لصحة المنام أو الجزم بأحد النقلين."
    }
  ]
}
